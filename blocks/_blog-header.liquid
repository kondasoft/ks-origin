{% doc %}
Renders the blog page heading and optional tag-aware breadcrumbs.
{% enddoc %}

{% assign active_blog_tag = current_tags | first %}

<div
  class="blog-header-block section-spacing"
  data-custom-colors="{{ block.settings.custom_colors }}"
  style="
    --pt: {{ block.settings.pt | divided_by: 16.0 | append: 'em' }};
    --pb: {{ block.settings.pb | divided_by: 16.0 | append: 'em' }};
    {% if block.settings.custom_colors %}
      --color-background: {{ block.settings.background_color.red }} {{ block.settings.background_color.green }} {{ block.settings.background_color.blue }};
      --color-text: {{ block.settings.text_color.red }} {{ block.settings.text_color.green }} {{ block.settings.text_color.blue }};
      --color-accent: {{ block.settings.accent_color.red }} {{ block.settings.accent_color.green }} {{ block.settings.accent_color.blue }};
    {% endif %}
  "
  {{ block.shopify_attributes }}
>
  <div class="container {{ settings.container_width }}">
    <header
      class="main-blog-header responsive-text-alignment"
      data-mobile-text-alignment="{{ block.settings.mobile_text_alignment }}"
      data-desktop-text-alignment="{{ block.settings.desktop_text_alignment }}"
      style="
        --mobile-text-alignment: {{ block.settings.mobile_text_alignment }};
        --desktop-text-alignment: {{ block.settings.desktop_text_alignment }};
      "
    >
      {% if block.settings.show_breadcrumbs %}
        {% if active_blog_tag != blank %}
          {% render 'breadcrumb',
            current_title: active_blog_tag,
            parent_title: blog.title,
            parent_url: blog.url
          %}
        {% else %}
          {% render 'breadcrumb', current_title: blog.title %}
        {% endif %}
      {% endif %}

      <h1 class="main-blog-title {{ block.settings.heading_size }}">
        {{ blog.title | escape }}
      </h1>
    </header>
  </div>
</div>

{% schema %}
{
  "name": "Blog header",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "checkbox",
      "id": "custom_colors",
      "label": "Use custom colors",
      "info": "Overrides the colors inherited from the parent section.",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "{{ settings.colors.surface }}",
      "visible_if": "{{ block.settings.custom_colors }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "{{ settings.colors.text }}",
      "visible_if": "{{ block.settings.custom_colors }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "{{ settings.colors.accent }}",
      "visible_if": "{{ block.settings.custom_colors }}"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text_alignment",
      "id": "mobile_text_alignment",
      "label": "Mobile text alignment",
      "default": "center"
    },
    {
      "type": "text_alignment",
      "id": "desktop_text_alignment",
      "label": "Desktop text alignment",
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h1",
      "info": "Changes the visual size only. The HTML heading remains H1."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 60
    }
  ]
}
{% endschema %}
