{% if section.index <= 3 or request.design_mode %}
  <link href="{{ 'contact-form.css' | asset_url }}" rel="stylesheet" fetchpriority="high">
{% endif %}

{% assign form_id = 'ContactForm-' | append: section.id | append: '-' | append: block.id %}

<div
  class="contact-form-block block-spacing"
  style="
    --pt: {{ block.settings.pt | divided_by: 16.0 | append: 'em' }};
    --pb: {{ block.settings.pb | divided_by: 16.0 | append: 'em' }};
  "
  data-section-css="{{ 'contact-form.css' | asset_url }}"
  {{ block.shopify_attributes }}
>
  {% form 'contact', id: form_id, class: 'contact-form-form' %}
    {% liquid
      assign form_matches = false

      if form.id == form_id or form.id == blank
        assign form_matches = true
      endif
    %}

    {% if form.errors and form_matches %}
      <div
        id="{{ form_id }}-error"
        class="contact-form-status alert alert-error"
        role="alert"
        tabindex="-1"
        autofocus
      >
        {{ form.errors | default_errors }}
      </div>
    {% endif %}

    {% if form.posted_successfully? and form_matches %}
      <div
        class="contact-form-status alert alert-success"
        role="status"
        tabindex="-1"
        autofocus
      >
        {{ 'general.contact.form.success' | t }}
      </div>
    {% endif %}

    <div class="contact-form-row">
      <div class="input-group">
        <label for="{{ form_id }}-name">{{ 'general.contact.form.name' | t }}</label>
        <input
          id="{{ form_id }}-name"
          class="input"
          type="text"
          name="contact[name]"
          autocomplete="name"
          value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
        >
      </div>

      <div class="input-group">
        <label for="{{ form_id }}-email">
          {{ 'general.contact.form.email' | t }}
          <span aria-hidden="true">*</span>
        </label>
        <input
          id="{{ form_id }}-email"
          class="input"
          type="email"
          name="contact[email]"
          autocomplete="email"
          autocapitalize="off"
          spellcheck="false"
          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
          aria-required="true"
          required
          {% if form.errors contains 'email' and form_matches %}
            aria-invalid="true"
            aria-describedby="{{ form_id }}-error"
          {% endif %}
        >
      </div>
    </div>

    <div class="input-group">
      <label for="{{ form_id }}-phone">{{ 'general.contact.form.phone' | t }}</label>
      <input
        id="{{ form_id }}-phone"
        class="input"
        type="tel"
        name="contact[phone]"
        autocomplete="tel"
        value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
      >
    </div>

    <div class="input-group">
      <label for="{{ form_id }}-body">{{ 'general.contact.form.message' | t }}</label>
      <textarea
        id="{{ form_id }}-body"
        class="input"
        name="contact[body]"
        rows="8"
      >{{ form.body }}</textarea>
    </div>

    <button class="btn btn-wide btn-md btn-accent-solid" type="submit">
      {{ 'general.contact.form.send' | t }}
    </button>
  {% endform %}
</div>

{% schema %}
{
  "name": "Contact form",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Contact form",
      "category": "Contact"
    }
  ]
}
{% endschema %}
