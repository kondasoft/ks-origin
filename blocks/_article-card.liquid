{% doc %}
Renders the ordered inner blocks shared by every article card in an article grid.

@example
{% content_for 'block', type: '_article-card', id: 'article-card', closest.article: article %}
{% enddoc %}

<article
  class="article-card"
  data-text-alignment="{{ block.settings.text_alignment }}"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks', closest.article: closest.article %}
</article>

{% schema %}
{
  "name": "Article card",
  "tag": null,
  "settings": [
    {
      "type": "text_alignment",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "left"
    }
  ],
  "blocks": [
    {
      "type": "_article-card-image"
    },
    {
      "type": "_article-card-heading"
    },
    {
      "type": "_article-card-meta"
    },
    {
      "type": "_article-card-excerpt"
    },
    {
      "type": "_article-card-read-more"
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
