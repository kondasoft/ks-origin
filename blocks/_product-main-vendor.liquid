{% liquid
  assign product = closest.product
  assign vendor = product.vendor

  if product == blank
    assign vendor = 'products.placeholders.vendor' | t
  endif
%}

{% if vendor != blank %}
  <div
    class="product-main-vendor-block block-spacing"
    style="
      --pt: {{ block.settings.pt | divided_by: 16.0 | append: 'em' }};
      --pb: {{ block.settings.pb | divided_by: 16.0 | append: 'em' }};
    "
    {{ block.shopify_attributes }}
  >
    <p class="product-vendor {{ block.settings.text_size }}">
      {{ vendor | escape }}
    </p>
  </div>
{% endif %}

{% schema %}
{
  "name": "Product vendor",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "options": [
        { "value": "fs-xs", "label": "Extra small" },
        { "value": "fs-sm", "label": "Small" },
        { "value": "fs-md", "label": "Medium" },
        { "value": "fs-lg", "label": "Large" },
        { "value": "fs-xl", "label": "Extra large" }
      ],
      "default": "fs-sm"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "Product vendor",
      "category": "Product"
    }
  ]
}
{% endschema %}
