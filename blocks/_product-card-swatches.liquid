{% liquid
  assign product = closest.product
  assign swatch_option = null
  assign linked_swatch_option = null
  assign product_colors = product.metafields.shopify['color-pattern'].value

  for product_option in product.options_with_values
    for option_value in product_option.values
      capture swatch_source
        render 'product-option-swatch', option_value: option_value, product_colors: product_colors, output: 'source'
      endcapture
      assign swatch_source = swatch_source | strip

      if swatch_source == 'native'
        assign swatch_option = product_option
        break
      elsif swatch_source == 'linked' and linked_swatch_option == blank
        assign linked_swatch_option = product_option
      endif
    endfor

    if swatch_option != blank
      break
    endif
  endfor

  assign swatch_option = swatch_option | default: linked_swatch_option
%}

{% if swatch_option != blank %}
  <product-card-swatches
    class="product-card-swatches-block block-spacing"
    style="
      --pt: {{ block.settings.pt | divided_by: 16.0 | append: 'em' }};
      --pb: {{ block.settings.pb | divided_by: 16.0 | append: 'em' }};
    "
    {{ block.shopify_attributes }}
  >
    <ul
      class="product-card-swatches"
      role="list"
      aria-label="{{ swatch_option.name | escape }}"
      style="--product-card-swatch-size: {{ block.settings.swatch_size }}px;"
    >
      {% for option_value in swatch_option.values %}
        {% liquid
          assign swatch_variant = option_value.variant
          assign variant_image = swatch_variant.featured_media.preview_image
          assign variant_image_alt = variant_image.alt | default: product.title
          capture swatch_markup
            render 'product-option-swatch', option_value: option_value, product_colors: product_colors, size: block.settings.swatch_size, swatch_class: 'product-card-swatch-fill', image_class: 'product-card-swatch-image'
          endcapture
          assign swatch_markup = swatch_markup | strip
        %}
        {% if swatch_markup != blank %}
          <li class="product-card-swatch-item">
            <label
              class="product-card-swatch"
              title="{{ option_value | escape }}"
            >
              <input
                class="visually-hidden"
                type="radio"
                name="product-card-swatch-{{ block.id }}-{{ product.id }}"
                value="{{ swatch_variant.id }}"
                data-product-card-swatch
                data-variant-url="{{ swatch_variant.url }}"
                {% if option_value.selected %}checked{% endif %}
              >
              {{ swatch_markup }}
              <span class="visually-hidden">{{ option_value | escape }}</span>
            </label>

            {% if variant_image != blank %}
              <template data-product-card-swatch-image>
                {{
                  variant_image
                  | image_url: width: 2400
                  | image_tag:
                    alt: variant_image_alt,
                    class: 'product-card-image',
                    widths: '320, 640, 960, 1280, 1600, 2000, 2400',
                    sizes: 'auto, (min-width: 1200px) 33vw, 50vw',
                    loading: 'lazy'
                }}
              </template>
            {% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </product-card-swatches>
{% endif %}

{% schema %}
{
  "name": "Product swatches",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "swatch_size",
      "label": "Swatch size",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 22
    }
  ],
  "presets": [
    {
      "name": "Product swatches",
      "category": "Product"
    }
  ]
}
{% endschema %}
