{% doc %}
Renders the ordered inner blocks shared by every product card in a product grid.

@param {object} [card_grid_settings] - Settings from a containing grid block.
@param {boolean} [narrow_card_grid] - Whether the grid sits in a product details column.

@example
{% content_for 'block', type: 'product-card', id: 'product-card', closest.product: product %}
{% enddoc %}

{% liquid
  assign card_grid_settings = card_grid_settings | default: section.settings
  assign product_view_context = 'page'
  assign card_text_alignment = block.settings.text_alignment
  assign card_border_opacity = block.settings.border_opacity
  assign card_show_box_shadow = block.settings.show_box_shadow

  if block.settings.use_global_appearance_settings
    assign card_text_alignment = settings.product_card_text_alignment
    assign card_border_opacity = settings.product_card_border_opacity
    assign card_show_box_shadow = settings.product_card_show_box_shadow
  endif

  if recommendations.performed
    assign product_view_context = 'recommendation'
  elsif request.page_type == 'collection'
    assign product_view_context = 'collection'
  elsif request.page_type == 'search'
    assign product_view_context = 'search'
  endif
%}

<s-view-event
  class="product-card-view-event"
  view-event-trigger="intersect"
  {% if closest.product != blank %}
    view-event-payload="{{ closest.product | standard_event_data: 'view', context: product_view_context | escape }}"
  {% endif %}
>
  <article
    class="product-card"
    style="
      --card-border-opacity: {{ card_border_opacity | divided_by: 100.0 }};
      --card-pt: {{ block.settings.pt | divided_by: 16.0 | append: 'em' }};
      --card-pb: {{ block.settings.pb | divided_by: 16.0 | append: 'em' }};
      --card-pl: {{ block.settings.pl | divided_by: 16.0 | append: 'em' }};
      --card-pr: {{ block.settings.pr | divided_by: 16.0 | append: 'em' }};
      {% if block.settings.custom_colors %}
        --color-background: {{ block.settings.background_color.red }} {{ block.settings.background_color.green }} {{ block.settings.background_color.blue }};
        --color-text: {{ block.settings.text_color.red }} {{ block.settings.text_color.green }} {{ block.settings.text_color.blue }};
        --color-accent: {{ block.settings.accent_color.red }} {{ block.settings.accent_color.green }} {{ block.settings.accent_color.blue }};
      {% endif %}
    "
    data-border-opacity="{{ card_border_opacity }}"
    data-custom-colors="{{ block.settings.custom_colors }}"
    data-box-shadow="{{ card_show_box_shadow }}"
    data-text-alignment="{{ card_text_alignment }}"
    {{ block.shopify_attributes }}
  >
    {% capture card_content %}
      {% content_for 'blocks', closest.product: closest.product %}
    {% endcapture %}
    {% render 'card-image-sizes',
      grid_settings: card_grid_settings,
      custom_colors: block.settings.custom_colors,
      narrow_grid: narrow_card_grid,
      content: card_content
    %}
  </article>
</s-view-event>

{% schema %}
{
  "name": "Product card",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "checkbox",
      "id": "custom_colors",
      "label": "Use custom colors",
      "info": "Overrides the colors inherited from the parent section.",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "{{ settings.colors.background }}",
      "visible_if": "{{ block.settings.custom_colors }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "{{ settings.colors.text }}",
      "visible_if": "{{ block.settings.custom_colors }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "{{ settings.colors.accent }}",
      "visible_if": "{{ block.settings.custom_colors }}"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "use_global_appearance_settings",
      "label": "Use global appearance settings",
      "default": false
    },
    {
      "type": "text_alignment",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "left",
      "visible_if": "{{ block.settings.use_global_appearance_settings == false }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "label": "Border opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0,
      "visible_if": "{{ block.settings.use_global_appearance_settings == false }}"
    },
    {
      "type": "checkbox",
      "id": "show_box_shadow",
      "label": "Show box shadow",
      "default": false,
      "visible_if": "{{ block.settings.use_global_appearance_settings == false }}"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pl",
      "label": "Left",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pr",
      "label": "Right",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "_product-card-image"
    },
    {
      "type": "_product-card-title"
    },
    {
      "type": "_product-card-price"
    },
    {
      "type": "_product-vendor"
    },
    {
      "type": "_product-sku"
    },
    {
      "type": "_product-card-rating"
    },
    {
      "type": "_product-card-swatches"
    },
    {
      "type": "_product-card-form"
    },
    {
      "type": "group"
    },
    {
      "type": "divider"
    },
    {
      "type": "text"
    },
    {
      "type": "custom-liquid"
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
