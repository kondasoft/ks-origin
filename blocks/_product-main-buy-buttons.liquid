{% liquid
  assign product = closest.product
  assign selected_variant = product.selected_or_first_available_variant
  assign product_form_id = 'product-main-form-' | append: block.id | append: '-' | append: product.id
  assign cart_quantity = cart | item_count_for_variant: selected_variant.id
  assign quantity_min = selected_variant.quantity_rule.min | default: 1
  assign quantity_increment = selected_variant.quantity_rule.increment | default: 1
  assign quantity_max = blank
  assign quantity_unavailable = false
  assign has_quantity_rules = false

  for variant in product.variants
    if variant.quantity_rule.min > 1 or variant.quantity_rule.increment > 1 or variant.quantity_rule.max != null
      assign has_quantity_rules = true
      break
    endif
  endfor

  if selected_variant.quantity_rule.max != null
    assign quantity_max = selected_variant.quantity_rule.max | minus: cart_quantity | at_least: 0
  endif
  assign all_inventory_in_cart = false
  assign show_gift_card_recipient_form = false

  if product.gift_card? and block.settings.show_gift_card_recipient_form
    assign show_gift_card_recipient_form = true
  endif

  if selected_variant.inventory_management != blank and selected_variant.inventory_policy == 'deny'
    assign inventory_remaining = selected_variant.inventory_quantity | minus: cart_quantity | at_least: 0
    if quantity_max == blank
      assign quantity_max = inventory_remaining
    else
      assign quantity_max = quantity_max | at_most: inventory_remaining
    endif

    if selected_variant.inventory_quantity > 0 and cart_quantity >= selected_variant.inventory_quantity
      assign all_inventory_in_cart = true
    endif
  endif

  if quantity_max != blank
    assign quantity_max = quantity_max | divided_by: quantity_increment | times: quantity_increment
    if quantity_max < quantity_min
      assign quantity_unavailable = true
    endif
  endif
%}

<div
  class="product-main-buy-buttons block-spacing"
  data-product-buy-buttons
  data-add-to-cart-text="{{ 'products.form.add_to_cart' | t | escape }}"
  data-quantity-unavailable-text="{{ 'products.form.quantity_unavailable' | t | escape }}"
  data-all-inventory-in-cart-text="{{ 'products.form.all_inventory_in_cart' | t | escape }}"
  data-sold-out-text="{{ 'products.form.sold_out' | t | escape }}"
  style="
    --pt: {{ block.settings.pt | divided_by: 16.0 | append: 'em' }};
    --pb: {{ block.settings.pb | divided_by: 16.0 | append: 'em' }};
  "
  {{ block.shopify_attributes }}
>
  {% if product == blank %}
    <div class="product-main-buy-buttons-primary">
      <button
        type="button"
        class="btn {{ block.settings.add_to_cart_size }} {{ block.settings.button_style }}"
        disabled
      >
        {{ 'products.form.add_to_cart' | t }}
      </button>
    </div>
  {% else %}
    {% if product.has_only_default_variant %}
      {% comment %}Single-variant products still need the shared cart-limit refresh without visible options.{% endcomment %}
      {% render 'product-variant-picker', product: product, id: block.id, data_only: true %}
    {% endif %}
    <theme-product-form data-source="product-main">
      {% form 'product', product,
        id: product_form_id,
        class: 'product-main-buy-buttons-form'
      %}
        <p class="alert alert-with-icon alert-warning" data-cart-inventory-message{% unless quantity_unavailable and selected_variant.available %} hidden{% endunless %}>
          {% if all_inventory_in_cart %}{{ 'products.form.all_inventory_in_cart' | t }}{% else %}{{ 'products.form.quantity_unavailable' | t }}{% endif %}
        </p>

        <input type="hidden" name="id" value="{{ selected_variant.id }}" data-product-variant-input>

        {% if show_gift_card_recipient_form %}
          {% render 'gift-card-recipient-form', form: form, block: block %}
        {% endif %}

        {% if has_quantity_rules %}
          <p
            class="product-main-quantity-rules fs-sm"
            data-quantity-rules
            data-minimum-text="{{ 'products.quantity.minimum' | t: minimum: '[minimum]' | escape }}"
            data-increments-text="{{ 'products.quantity.increments' | t: increment: '[increment]' | escape }}"
            data-maximum-text="{{ 'products.quantity.maximum' | t: maximum: '[maximum]' | escape }}"
            data-in-cart-text="{{ 'products.quantity.in_cart' | t: quantity: '[quantity]' | escape }}"
            {% if selected_variant.quantity_rule.min == 1 and selected_variant.quantity_rule.increment == 1 and selected_variant.quantity_rule.max == null %}hidden{% endif %}
          >
            {%- assign separator = '' -%}
            {%- if quantity_min > 1 -%}
              {{- 'products.quantity.minimum' | t: minimum: quantity_min -}}
              {%- assign separator = ' · ' -%}
            {%- endif -%}
            {%- if quantity_increment > 1 -%}
              {{- separator -}}{{- 'products.quantity.increments' | t: increment: quantity_increment -}}
              {%- assign separator = ' · ' -%}
            {%- endif -%}
            {%- if selected_variant.quantity_rule.max != null -%}
              {{- separator -}}{{- 'products.quantity.maximum' | t: maximum: selected_variant.quantity_rule.max -}}
              {%- assign separator = ' · ' -%}
            {%- endif -%}
            {%- if cart_quantity > 0 -%}
              {{- separator -}}{{- 'products.quantity.in_cart' | t: quantity: cart_quantity -}}
            {%- endif -%}
          </p>
        {% endif %}

        <div class="product-main-buy-buttons-primary">
          {% if block.settings.show_quantity %}
            <quantity-input class="quantity-input" role="group" aria-label="{{ 'products.quantity.label' | t }}">
              <button
                type="button"
                class="quantity-input-button quantity-input-button-decrease"
                aria-label="{{ 'products.quantity.decrease' | t }}"
                data-quantity-decrease
                disabled
              >
                {% render 'svg-icons', icon: 'minus', icon_size: 16 %}
              </button>
              <input
                class="input"
                type="number"
                name="quantity"
                value="{{ quantity_min }}"
                min="{{ quantity_min }}"
                step="{{ quantity_increment }}"
                {% if quantity_max != blank %}max="{{ quantity_max }}"{% endif %}
                {% if selected_variant.available == false or quantity_unavailable %}disabled{% endif %}
                aria-label="{{ 'products.quantity.label' | t }}"
                data-quantity-input
              >
              <button
                type="button"
                class="quantity-input-button quantity-input-button-increase"
                aria-label="{{ 'products.quantity.increase' | t }}"
                data-quantity-increase
                {% if quantity_max != blank and quantity_max <= quantity_min %}disabled{% endif %}
              >
                {% render 'svg-icons', icon: 'plus', icon_size: 16 %}
              </button>
            </quantity-input>
          {% else %}
            <input type="hidden" name="quantity" value="{{ quantity_min }}" min="{{ quantity_min }}" step="{{ quantity_increment }}" {% if quantity_max != blank %}max="{{ quantity_max }}"{% endif %} data-quantity-input>
          {% endif %}

          <button
            type="submit"
            name="add"
            class="btn {{ block.settings.add_to_cart_size }} {{ block.settings.button_style }}"
            data-add-to-cart-button
            {% if selected_variant.available == false or quantity_unavailable %}disabled{% endif %}
          >
            <span data-add-to-cart-text>
              {% if selected_variant.available %}
                {{ 'products.form.add_to_cart' | t }}
              {% else %}
                {{ 'products.form.sold_out' | t }}
              {% endif %}
            </span>
          </button>
        </div>

        {% if block.settings.show_buy_it_now and show_gift_card_recipient_form == false %}
          <theme-buy-it-now data-cart-url="{{ routes.cart_url }}">
            <a
              href="{{ routes.cart_url }}/{{ selected_variant.id }}:{{ quantity_min }}"
              class="btn {{ block.settings.buy_it_now_size }} {{ block.settings.buy_it_now_style }}"
              data-buy-it-now
              {% if selected_variant.available == false or quantity_unavailable %}aria-disabled="true" tabindex="-1"{% endif %}
            >
              {{ 'products.form.buy_it_now' | t }}
            </a>
          </theme-buy-it-now>
        {% endif %}

        {% if block.settings.show_dynamic_checkout and selected_variant.available %}
          {{ form | payment_button }}
        {% endif %}
      {% endform %}
    </theme-product-form>
  {% endif %}
</div>

{% schema %}
{
  "name": "Buy buttons",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Quantity selector"
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity selector",
      "default": true
    },
    {
      "type": "header",
      "content": "Add to cart"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style",
      "options": [
        { "value": "btn-accent-solid", "label": "Accent solid" },
        { "value": "btn-accent-outline", "label": "Accent outline" },
        { "value": "btn-text-solid", "label": "Text solid" },
        { "value": "btn-text-outline", "label": "Text outline" }
      ],
      "default": "btn-accent-solid"
    },
    {
      "type": "select",
      "id": "add_to_cart_size",
      "label": "Size",
      "options": [
        { "value": "btn-sm", "label": "Small" },
        { "value": "btn-md", "label": "Medium" },
        { "value": "btn-lg", "label": "Large" }
      ],
      "default": "btn-md"
    },
    {
      "type": "header",
      "content": "Buy it now"
    },
    {
      "type": "checkbox",
      "id": "show_buy_it_now",
      "label": "Show button",
      "default": true
    },
    {
      "type": "select",
      "id": "buy_it_now_style",
      "label": "Style",
      "options": [
        { "value": "btn-accent-solid", "label": "Accent solid" },
        { "value": "btn-accent-outline", "label": "Accent outline" },
        { "value": "btn-text-solid", "label": "Text solid" },
        { "value": "btn-text-outline", "label": "Text outline" }
      ],
      "default": "btn-text-outline",
      "visible_if": "{{ block.settings.show_buy_it_now }}"
    },
    {
      "type": "select",
      "id": "buy_it_now_size",
      "label": "Size",
      "options": [
        { "value": "btn-sm", "label": "Small" },
        { "value": "btn-md", "label": "Medium" },
        { "value": "btn-lg", "label": "Large" }
      ],
      "default": "btn-md",
      "visible_if": "{{ block.settings.show_buy_it_now }}"
    },
    {
      "type": "header",
      "content": "Dynamic checkout"
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout button",
      "default": false
    },
    {
      "type": "header",
      "content": "Gift card products"
    },
    {
      "type": "checkbox",
      "id": "show_gift_card_recipient_form",
      "label": "Show recipient form",
      "info": "Allows customers to send gift cards to a recipient with an optional message and delivery date. Only appears on gift card products.",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Buy buttons",
      "category": "Product"
    }
  ]
}
{% endschema %}
