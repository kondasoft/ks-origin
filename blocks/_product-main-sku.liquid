{% liquid
  assign product = closest.product
  assign sku = product.selected_or_first_available_variant.sku

  if product == blank
    assign sku = 'products.placeholders.sku' | t
  endif
%}

{% if sku != blank %}
  <div
    class="product-main-sku-block block-spacing"
    style="
      --pt: {{ block.settings.pt | divided_by: 16.0 | append: 'em' }};
      --pb: {{ block.settings.pb | divided_by: 16.0 | append: 'em' }};
    "
    {{ block.shopify_attributes }}
  >
    <p class="product-main-sku {{ block.settings.text_size }}">
      {{ 'products.sku' | t: sku: sku }}
    </p>
  </div>
{% endif %}

{% schema %}
{
  "name": "Product SKU",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "options": [
        { "value": "fs-xs", "label": "Extra small" },
        { "value": "fs-sm", "label": "Small" },
        { "value": "fs-md", "label": "Medium" },
        { "value": "fs-lg", "label": "Large" },
        { "value": "fs-xl", "label": "Extra large" }
      ],
      "default": "fs-sm"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product SKU",
      "category": "Product"
    }
  ]
}
{% endschema %}
