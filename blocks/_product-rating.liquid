{% liquid
  assign product = closest.product
  assign product_rating = product.metafields.reviews.rating.value
  assign rating = product_rating.rating
  assign scale_max = product_rating.scale_max | default: 5
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0

  if product == blank
    assign rating = 4.5
    assign scale_max = 5
    assign rating_count = 12
  endif

  assign rating_value = rating | round: 1
  assign rating_percentage = rating | times: 100.0 | divided_by: scale_max
%}

{% if rating != blank %}
  <div
    class="product-rating {{ block.settings.rating_size }}"
    style="--product-rating-percentage: {{ rating_percentage }}%;"
    {{ block.shopify_attributes }}
  >
    <span class="product-rating-stars" aria-hidden="true">★★★★★</span>
    <span class="visually-hidden">
      {{ 'products.rating.value' | t: rating: rating_value, scale_max: scale_max }}
    </span>

    {% if block.settings.show_count %}
      <span
        class="product-rating-count"
        aria-label="{{ 'products.rating.reviews' | t: count: rating_count }}"
      >
        ({{ rating_count }})
      </span>
    {% endif %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Product rating",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Requires a reviews app that writes to Shopify's standard product rating metafields."
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show review count",
      "default": true
    },
    {
      "type": "select",
      "id": "rating_size",
      "label": "Rating size",
      "options": [
        { "value": "fs-xs", "label": "Extra small" },
        { "value": "fs-sm", "label": "Small" },
        { "value": "fs-md", "label": "Medium" },
        { "value": "fs-lg", "label": "Large" },
        { "value": "fs-xl", "label": "Extra large" }
      ],
      "default": "fs-sm"
    }
  ],
  "presets": [
    {
      "name": "Product rating",
      "category": "Product"
    }
  ]
}
{% endschema %}
