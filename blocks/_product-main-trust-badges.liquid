{% liquid
  assign badge_count = 0

  for index in (1..6)
    assign image_key = 'image_' | append: index
    assign text_key = 'text_' | append: index

    if block.settings[image_key] != blank or block.settings[text_key] != blank
      assign badge_count = badge_count | plus: 1
    endif
  endfor

  assign badge_columns = badge_count | at_most: 3
%}

{% if badge_count > 0 %}
  <div
    class="product-main-trust-badges-block block-spacing"
    style="
      --trust-badge-columns: {{ badge_columns }};
      --trust-badge-icon-size: {{ block.settings.icon_size | append: 'px' }};
      --pt: {{ block.settings.pt | divided_by: 16.0 | append: 'em' }};
      --pb: {{ block.settings.pb | divided_by: 16.0 | append: 'em' }};
    "
    {{ block.shopify_attributes }}
  >
    <ul class="product-main-trust-badges-list" data-layout="{{ block.settings.layout }}">
      {% for index in (1..6) %}
        {% liquid
          assign image_key = 'image_' | append: index
          assign text_key = 'text_' | append: index
          assign image = block.settings[image_key]
          assign text = block.settings[text_key]
          assign image_width = block.settings.icon_size | times: 2
          assign image_height = block.settings.icon_size

          if image != blank and image.aspect_ratio != blank
            assign image_height = block.settings.icon_size | divided_by: image.aspect_ratio | round
          endif
        %}

        {% if image != blank or text != blank %}
          <li class="product-main-trust-badge">
            {% if image != blank %}
              <img
                class="product-main-trust-badge-image"
                src="{{ image | image_url: width: image_width }}"
                alt="{{ image.alt | escape }}"
                width="{{ block.settings.icon_size }}"
                height="{{ image_height }}"
                loading="lazy"
                data-transform-svg-inline
              >
            {% endif %}

            {% if text != blank %}
              <div class="product-main-trust-badge-text rte {{ block.settings.text_size }}">
                {{ text }}
              </div>
            {% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
{% endif %}

