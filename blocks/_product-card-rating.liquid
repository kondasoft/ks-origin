{% render 'product-rating',
  product: closest.product,
  rating_size: block.settings.rating_size,
  show_count: block.settings.show_count,
  count_style: block.settings.count_style,
  classes: 'product-card-rating',
  block: block
%}

{% schema %}
{
  "name": "Product rating",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Requires a reviews app that writes to Shopify's standard product rating metafields."
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show review count",
      "default": true
    },
    {
      "type": "select",
      "id": "count_style",
      "label": "Review count style",
      "options": [
        { "value": "simple", "label": "Simple" },
        { "value": "detailed", "label": "Detailed" }
      ],
      "default": "simple",
      "visible_if": "{{ block.settings.show_count }}"
    },
    {
      "type": "select",
      "id": "rating_size",
      "label": "Rating size",
      "options": [
        { "value": "fs-xs", "label": "Extra small" },
        { "value": "fs-sm", "label": "Small" },
        { "value": "fs-md", "label": "Medium" },
        { "value": "fs-lg", "label": "Large" },
        { "value": "fs-xl", "label": "Extra large" }
      ],
      "default": "fs-sm"
    }
  ],
  "presets": [
    {
      "name": "Product rating",
      "category": "Product"
    }
  ]
}
{% endschema %}
