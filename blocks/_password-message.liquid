{% doc %}
Renders the password protection visitor message at the merchant's chosen position.
{% enddoc %}

{% render 'password-message',
  text_size: block.settings.text_size,
  pt: block.settings.pt,
  pb: block.settings.pb,
  shopify_attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "Visitor message",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Edit the message in Online Store > Preferences > Password protection."
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "options": [
        { "value": "fs-xs", "label": "Extra small" },
        { "value": "fs-sm", "label": "Small" },
        { "value": "fs-md", "label": "Medium" },
        { "value": "fs-lg", "label": "Large" },
        { "value": "fs-xl", "label": "Extra large" }
      ],
      "default": "fs-md"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Visitor message",
      "category": "Text"
    }
  ]
}
{% endschema %}
