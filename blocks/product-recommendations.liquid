{% doc %}
Renders related or complementary product recommendations inside product content.

@example
{% content_for 'block', type: 'product-recommendations', id: 'product-recommendations', closest.product: product %}
{% enddoc %}

{% liquid
  assign recommendation_product = closest.product | default: product
  assign products_to_show = block.settings.products_to_show | default: 6
  assign layout = block.settings.layout | default: 'carousel'
  assign recommended_products = recommendations.products
  assign has_recommendations = false
  assign carousel_label = block.settings.heading

  if carousel_label == blank
    assign carousel_label = 'accessibility.products_carousel' | t
  endif

  if recommendations.performed and recommendations.products_count == 0
    if block.settings.recommendation_type == 'related'
      assign recommended_products = collections.all.products | reject: 'id', recommendation_product.id
    else
      assign recommended_products = null
    endif
  endif

  if recommendations.performed and recommended_products.size > 0
    assign has_recommendations = true
  endif
%}

<script src="{{ 'product-recommendations.js' | asset_url }}" type="module" fetchpriority="low"></script>
<link href="{{ 'product-recommendations-block.css' | asset_url }}" rel="stylesheet">
<link href="{{ 'product-card.css' | asset_url }}" rel="stylesheet">

<product-recommendations
  id="ProductRecommendations-{{ block.id }}"
  class="product-recommendations-block block-spacing"
  data-url="{{ routes.product_recommendations_url }}?limit={{ products_to_show }}"
  data-product-id="{{ recommendation_product.id }}"
  data-section-id="{{ section.id }}"
  data-intent="{{ block.settings.recommendation_type }}"
  data-recommendations-performed="{{ recommendations.performed }}"
  data-has-recommendations="{{ has_recommendations }}"
  data-intersection-observer
  data-intersection-root-margin="0px 0px 400px 0px"
  data-section-css="{{ 'product-recommendations-block.css' | asset_url }}, {{ 'product-card.css' | asset_url }}"
  style="
    --pt: {{ block.settings.pt | divided_by: 16.0 | append: 'em' }};
    --pb: {{ block.settings.pb | divided_by: 16.0 | append: 'em' }};
  "
  {% if recommendations.performed and has_recommendations == false %}hidden{% endif %}
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <h2 class="product-recommendations-block-heading {{ block.settings.heading_size }}">
      {{ block.settings.heading }}
    </h2>
  {% endif %}

  {% if recommendations.performed %}
    {% if layout == 'carousel' %}
      <theme-carousel
        class="theme-carousel"
        data-align-navigation-to-media="{{ block.settings.carousel_align_navigation_to_media }}"
        data-partial-slide-mobile="{{ block.settings.carousel_partial_slide_mobile }}"
        role="region"
        aria-roledescription="{{ 'accessibility.carousel' | t }}"
        aria-label="{{ carousel_label | escape }}"
        style="
          --carousel-columns-mobile: {{ block.settings.mobile_columns }};
          --carousel-columns-tablet: 2;
          --carousel-columns-desktop: {{ block.settings.desktop_columns }};
          --carousel-gap: 1rem;
        "
      >
        <div class="theme-carousel-track-wrapper">
          <ul
            id="product-recommendations-track-{{ block.id }}"
            class="theme-carousel-track"
            role="list"
            tabindex="0"
            data-carousel-track
          >
            {% for recommended_product in recommended_products limit: products_to_show %}
              <li class="product-recommendations-block-item theme-carousel-item" data-carousel-item>
                {% content_for 'block',
                  type: 'product-card',
                  id: 'product-card',
                  closest.product: recommended_product
                %}
              </li>
            {% endfor %}
          </ul>

          {% if block.settings.carousel_show_navigation %}
            <div class="theme-carousel-controls">
              <button
                class="icon-button theme-carousel-control theme-carousel-control-previous"
                type="button"
                aria-label="{{ 'accessibility.previous' | t }}"
                aria-controls="product-recommendations-track-{{ block.id }}"
                data-carousel-previous
              >
                {% render 'svg-icons', icon: 'chevron-left', icon_size: 20 %}
              </button>
              <button
                class="icon-button theme-carousel-control theme-carousel-control-next"
                type="button"
                aria-label="{{ 'accessibility.next' | t }}"
                aria-controls="product-recommendations-track-{{ block.id }}"
                data-carousel-next
              >
                {% render 'svg-icons', icon: 'chevron-right', icon_size: 20 %}
              </button>
            </div>
          {% endif %}
        </div>

        {% if block.settings.carousel_show_progress %}
          <div class="theme-carousel-progress" aria-hidden="true">
            <div class="theme-carousel-progress-bar" data-carousel-progress-bar></div>
          </div>
        {% endif %}
      </theme-carousel>
    {% else %}
      <ul
        class="product-recommendations-block-grid"
        role="list"
        style="
          --mobile-columns: {{ block.settings.mobile_columns }};
          --desktop-columns: {{ block.settings.desktop_columns }};
        "
      >
        {% for recommended_product in recommended_products limit: products_to_show %}
          <li class="product-recommendations-block-item">
            {% content_for 'block',
              type: 'product-card',
              id: 'product-card',
              closest.product: recommended_product
            %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  {% else %}
    <ul
      class="product-recommendations-block-loading-grid"
      role="list"
      aria-label="{{ 'accessibility.loading_product_recommendations' | t }}"
      style="
        --mobile-columns: {{ block.settings.mobile_columns }};
        --desktop-columns: {{ block.settings.desktop_columns }};
      "
      inert
    >
      {% for index in (1..products_to_show) %}
        <li class="product-recommendations-block-loading-item">
          <span class="product-recommendations-block-loading-media"></span>
          <span class="product-recommendations-block-loading-line"></span>
          <span
            class="product-recommendations-block-loading-line product-recommendations-block-loading-line-short"
          ></span>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</product-recommendations>

{% schema %}
{
  "name": "Product recommendations",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "recommendation_type",
      "label": "Recommendation type",
      "options": [
        { "value": "related", "label": "Related" },
        { "value": "complementary", "label": "Complementary" }
      ],
      "default": "related"
    },
    {
      "type": "paragraph",
      "content": "Complementary products must be configured with Shopify's [Search & Discovery app](https://apps.shopify.com/search-and-discovery)."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pairs well with"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h5"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "carousel", "label": "Carousel" },
        { "value": "grid", "label": "Grid" }
      ],
      "default": "carousel"
    },
    {
      "type": "checkbox",
      "id": "carousel_partial_slide_mobile",
      "label": "Show part of the next product on mobile",
      "default": true,
      "visible_if": "{{ block.settings.layout == 'carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_show_navigation",
      "label": "Show navigation buttons",
      "default": true,
      "visible_if": "{{ block.settings.layout == 'carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_align_navigation_to_media",
      "label": "Align navigation to media",
      "info": "Centers navigation buttons against the card image. Disable to center them against the full card.",
      "default": true,
      "visible_if": "{{ block.settings.layout == 'carousel' and block.settings.carousel_show_navigation }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_show_progress",
      "label": "Show progress bar",
      "default": true,
      "visible_if": "{{ block.settings.layout == 'carousel' }}"
    },
    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "info": "Tablet layouts always use two columns.",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "product-card"
    }
  ],
  "presets": [
    {
      "name": "Product recommendations",
      "category": "Product",
      "settings": {
        "recommendation_type": "related",
        "heading": "Pairs well with"
      },
      "blocks": [
        {
          "type": "product-card",
          "id": "product-card",
          "static": true,
          "blocks": [
            {
              "type": "_product-card-image"
            },
            {
              "type": "_product-card-title"
            },
            {
              "type": "_product-card-rating"
            },
            {
              "type": "_product-card-price"
            },
            {
              "type": "_product-card-swatches"
            },
            {
              "type": "_product-card-form"
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
