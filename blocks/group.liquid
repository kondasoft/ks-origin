<div
  class="group-block block-spacing"
  style="
    --mobile-content-direction: {{ block.settings.mobile_content_direction }};
    --mobile-gap: {{ block.settings.mobile_gap | divided_by: 16.0 | append: 'rem' }};
    --desktop-content-direction: {{ block.settings.desktop_content_direction }};
    --desktop-gap: {{ block.settings.desktop_gap | divided_by: 16.0 | append: 'rem' }};
    --pt: {{ block.settings.pt | divided_by: 16.0 | append: 'em' }};
    --pb: {{ block.settings.pb | divided_by: 16.0 | append: 'em' }};
  "
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .group-block {
    display: flex;
    flex-direction: var(--mobile-content-direction);
    gap: var(--mobile-gap);
  }

  @media (min-width: 1200px) {
    .group-block {
      flex-direction: var(--desktop-content-direction);
      gap: var(--desktop-gap);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Group",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "mobile_content_direction",
      "label": "Direction",
      "options": [
        { "value": "column", "label": "Vertical" },
        { "value": "row", "label": "Horizontal" }
      ],
      "default": "column"
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Desktop"
    },
    {
      "type": "select",
      "id": "desktop_content_direction",
      "label": "Direction",
      "options": [
        { "value": "column", "label": "Vertical" },
        { "value": "row", "label": "Horizontal" }
      ],
      "default": "column"
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Desktop gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Group",
      "category": "Layout"
    }
  ]
}
{% endschema %}
