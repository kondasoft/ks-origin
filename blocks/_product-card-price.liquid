{% liquid
  assign product = closest.product

  if product == blank
    assign current_price = 1999 | money
  else
    assign current_price = product.price | money

    if product.price_varies
      assign current_price = 'products.price.from_price' | t: price: current_price
    endif
  endif
%}

<div
  class="product-card-price-block block-spacing"
  style="
    --pt: {{ block.settings.pt | divided_by: 16.0 | append: 'em' }};
    --pb: {{ block.settings.pb | divided_by: 16.0 | append: 'em' }};
  "
  {{ block.shopify_attributes }}
>
  <p class="product-card-price {{ block.settings.price_size }}">
    {% if product == blank %}
      <span class="visually-hidden">{{ 'products.price.regular_price' | t }}</span>
      <span class="product-card-price-current">{{ current_price }}</span>
    {% elsif product.compare_at_price > product.price %}
      <span class="visually-hidden">{{ 'products.price.sale_price' | t }}</span>
      <span class="product-card-price-current product-card-price-sale">{{ current_price }}</span>
      <span class="visually-hidden">{{ 'products.price.regular_price' | t }}</span>
      <s class="product-card-price-compare">{{ product.compare_at_price | money }}</s>
    {% else %}
      <span class="visually-hidden">{{ 'products.price.regular_price' | t }}</span>
      <span class="product-card-price-current">{{ current_price }}</span>
    {% endif %}
  </p>
</div>

{% schema %}
{
  "name": "Product price",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "price_size",
      "label": "Price size",
      "options": [
        { "value": "fs-xs", "label": "Extra small" },
        { "value": "fs-sm", "label": "Small" },
        { "value": "fs-md", "label": "Medium" },
        { "value": "fs-lg", "label": "Large" },
        { "value": "fs-xl", "label": "Extra large" }
      ],
      "default": "fs-md"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 14
    }
  ],
  "presets": [
    {
      "name": "Product price",
      "category": "Product"
    }
  ]
}
{% endschema %}
