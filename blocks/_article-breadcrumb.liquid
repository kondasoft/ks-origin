{% assign article = closest.article %}

<div
  class="article-breadcrumb-block block-spacing"
  style="
    --pt: {{ block.settings.pt | divided_by: 16.0 | append: 'em' }};
    --pb: {{ block.settings.pb | divided_by: 16.0 | append: 'em' }};
  "
  {{ block.shopify_attributes }}
>
  {% render 'breadcrumb',
    current_title: article.title,
    parent_title: blog.title,
    parent_url: blog.url
  %}
</div>

{% schema %}
{
  "name": "Article breadcrumb",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Article breadcrumb",
      "category": "Blog"
    }
  ]
}
{% endschema %}
