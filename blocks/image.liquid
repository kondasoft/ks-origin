{% liquid
  assign image_loading = 'lazy'
  assign image_class = 'image-block-image'

  unless block.settings.image_ratio == 'adapt'
    assign image_class = image_class | append: ' aspect-ratio aspect-ratio-' | append: block.settings.image_ratio
  endunless

  assign placeholder_class = image_class | append: ' placeholder-svg'
  assign image_render_width = 3200
  assign image_sizes = '100vw'

  if section.settings.mobile_columns != blank and section.settings.desktop_columns != blank
    assign mobile_image_size = 100.0 | divided_by: section.settings.mobile_columns | append: 'vw'
    assign desktop_image_size = 100.0 | divided_by: section.settings.desktop_columns | append: 'vw'
    assign image_sizes = '(min-width: 1200px) ' | append: desktop_image_size | append: ', ' | append: mobile_image_size
  endif

  if section.index == 1
    assign image_loading = 'eager'
  else
    assign image_sizes = 'auto, ' | append: image_sizes
  endif
%}

<div
  class="image-block block-spacing"
  style="
    --pt: {{ block.settings.pt | divided_by: 16.0 | append: 'em' }};
    --pb: {{ block.settings.pb | divided_by: 16.0 | append: 'em' }};
  "
  {{ block.shopify_attributes }}
>
  <div class="image-block-media">
    {% if block.settings.image != blank %}
      {{ block.settings.image
        | image_url: width: image_render_width
        | image_tag:
          class: image_class,
          widths: '320, 640, 960, 1280, 1920, 2560, 3200',
          sizes: image_sizes,
          loading: image_loading
      }}
    {% else %}
      {{ 'detailed-apparel-1' | placeholder_svg_tag: placeholder_class }}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Image",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Aspect ratio",
      "options": [
        { "group": "Adapt", "value": "adapt", "label": "Adapt to image" },
        { "group": "Square", "value": "square", "label": "Square (1:1)" },
        { "group": "Horizontal", "value": "landscape", "label": "Landscape (4:3)" },
        { "group": "Horizontal", "value": "widescreen", "label": "Widescreen (16:9)" },
        { "group": "Vertical", "value": "portrait", "label": "Portrait (3:4)" },
        { "group": "Vertical", "value": "vertical", "label": "Vertical (9:16)" }
      ],
      "default": "adapt"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Image",
      "category": "Media"
    }
  ]
}
{% endschema %}
