{% doc %}
Renders the ordered inner blocks shared by every collection card in a collection list.

@example
{% content_for 'block', type: 'collection-card', id: 'collection-card', closest.collection: collection %}
{% enddoc %}

<article
  class="collection-card"
  style="
    --card-border-opacity: {{ block.settings.border_opacity | divided_by: 100.0 }};
    --card-pt: {{ block.settings.pt | divided_by: 16.0 | append: 'em' }};
    --card-pb: {{ block.settings.pb | divided_by: 16.0 | append: 'em' }};
    --card-pl: {{ block.settings.pl | divided_by: 16.0 | append: 'em' }};
    --card-pr: {{ block.settings.pr | divided_by: 16.0 | append: 'em' }};
    {% if block.settings.custom_colors %}
      --color-background: {{ block.settings.background_color.red }} {{ block.settings.background_color.green }} {{ block.settings.background_color.blue }};
      --color-text: {{ block.settings.text_color.red }} {{ block.settings.text_color.green }} {{ block.settings.text_color.blue }};
      --color-accent: {{ block.settings.accent_color.red }} {{ block.settings.accent_color.green }} {{ block.settings.accent_color.blue }};
    {% endif %}
  "
  data-border-opacity="{{ block.settings.border_opacity }}"
  data-custom-colors="{{ block.settings.custom_colors }}"
  data-box-shadow="{{ block.settings.show_box_shadow }}"
  data-text-alignment="{{ block.settings.text_alignment }}"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks', closest.collection: closest.collection %}
</article>

{% schema %}
{
  "name": "Collection card",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "checkbox",
      "id": "custom_colors",
      "label": "Use custom colors",
      "info": "Overrides the colors inherited from the parent section.",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "{{ settings.colors.background }}",
      "visible_if": "{{ block.settings.custom_colors }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "{{ settings.colors.text }}",
      "visible_if": "{{ block.settings.custom_colors }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "{{ settings.colors.accent }}",
      "visible_if": "{{ block.settings.custom_colors }}"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "text_alignment",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "left"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "label": "Border opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_box_shadow",
      "label": "Show box shadow",
      "default": false
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pl",
      "label": "Left",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pr",
      "label": "Right",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "_collection-card-image"
    },
    {
      "type": "_collection-card-title"
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
