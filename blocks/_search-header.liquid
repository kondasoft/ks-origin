{% doc %}
Renders the search page heading and search form.
{% enddoc %}

{% liquid
  assign search_types = ''
  assign use_site_background_for_input = false

  if block.settings.custom_colors and block.settings.background_color == settings.color_surface
    assign use_site_background_for_input = true
  endif

  if section.settings.search_products
    assign search_types = 'product'
  endif

  if section.settings.search_articles
    if search_types != blank
      assign search_types = search_types | append: ','
    endif
    assign search_types = search_types | append: 'article'
  endif

  if section.settings.search_pages
    if search_types != blank
      assign search_types = search_types | append: ','
    endif
    assign search_types = search_types | append: 'page'
  endif

  if search_types == blank
    assign search_types = 'product'
  endif
%}

<div
  class="search-header-block section-spacing"
  data-custom-colors="{{ block.settings.custom_colors }}"
  data-surface-background="{{ use_site_background_for_input }}"
  style="
    --pt: {{ block.settings.pt | divided_by: 16.0 | append: 'em' }};
    --pb: {{ block.settings.pb | divided_by: 16.0 | append: 'em' }};
    {% if block.settings.custom_colors %}
      --color-background: {{ block.settings.background_color.red }} {{ block.settings.background_color.green }} {{ block.settings.background_color.blue }};
      --color-text: {{ block.settings.text_color.red }} {{ block.settings.text_color.green }} {{ block.settings.text_color.blue }};
      --color-accent: {{ block.settings.accent_color.red }} {{ block.settings.accent_color.green }} {{ block.settings.accent_color.blue }};
    {% endif %}
  "
  {{ block.shopify_attributes }}
>
  <div class="container {{ settings.container_width }}">
    <header
      class="main-search-header responsive-text-alignment"
      data-mobile-text-alignment="{{ block.settings.mobile_text_alignment }}"
      data-desktop-text-alignment="{{ block.settings.desktop_text_alignment }}"
      style="
        --mobile-text-alignment: {{ block.settings.mobile_text_alignment }};
        --desktop-text-alignment: {{ block.settings.desktop_text_alignment }};
      "
    >
      <h1
        class="main-search-title {{ block.settings.heading_size }}"
        data-search-heading
        data-results-title="{{ 'search.results_title' | t | escape }}"
      >
        {% if search.performed %}
          {{ 'search.results_title' | t }}
        {% else %}
          {{ 'search.title' | t }}
        {% endif %}
      </h1>

      <form
        class="main-search-form"
        action="{{ routes.search_url }}"
        method="get"
        role="search"
        data-search-submit-form
      >
        <input type="hidden" name="type" value="{{ search_types }}">
        <input type="hidden" name="options[prefix]" value="last">

        <div class="main-search-input-wrapper">
          <label class="visually-hidden" for="SearchInput-{{ section.id }}">
            {{ 'search.label' | t }}
          </label>
          <input
            id="SearchInput-{{ section.id }}"
            class="input main-search-input{% if block.settings.input_size == 'lg' %} input-lg{% endif %}"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ 'search.placeholder' | t }}"
            required
          >
          <button
            class="icon-button main-search-submit"
            type="submit"
            aria-label="{{ 'accessibility.search' | t }}"
          >
            {% render 'svg-icons', icon: 'search', icon_size: 22 %}
          </button>
        </div>
      </form>
    </header>
  </div>
</div>

{% schema %}
{
  "name": "Search header",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "checkbox",
      "id": "custom_colors",
      "label": "Use custom colors",
      "info": "Overrides the colors inherited from the parent section.",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "{{ settings.colors.surface }}",
      "visible_if": "{{ block.settings.custom_colors }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "{{ settings.colors.text }}",
      "visible_if": "{{ block.settings.custom_colors }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "{{ settings.colors.accent }}",
      "visible_if": "{{ block.settings.custom_colors }}"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text_alignment",
      "id": "mobile_text_alignment",
      "label": "Mobile text alignment",
      "default": "center"
    },
    {
      "type": "text_alignment",
      "id": "desktop_text_alignment",
      "label": "Desktop text alignment",
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h1",
      "info": "Changes the visual size only. The HTML heading remains H1."
    },
    {
      "type": "select",
      "id": "input_size",
      "label": "Search input size",
      "options": [
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" }
      ],
      "default": "lg"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 54
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 54
    }
  ]
}
{% endschema %}
