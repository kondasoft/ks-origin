{% liquid
  assign product = closest.product
  assign selected_variant = product.selected_or_first_available_variant
  assign product_form_id = 'product-card-form-' | append: block.id | append: '-' | append: product.id
  assign show_select_options = false

  if product != blank and product.available
    if product.variants.size > 1 or product.requires_selling_plan
      assign show_select_options = true
    endif
  endif
%}

<div
  class="product-card-form-block{% if show_select_options %} product-card-form-link-block{% endif %}"
  {{ block.shopify_attributes }}
>
  {% if product == blank %}
    <button
      type="button"
      class="btn {{ block.settings.button_size }} {{ block.settings.button_style }}"
    >
      {{ 'products.form.add_to_cart' | t }}
    </button>
  {% elsif product.available == false %}
    <button
      type="button"
      class="btn {{ block.settings.button_size }} {{ block.settings.button_style }}"
      disabled
    >
      {{ 'products.form.sold_out' | t }}
    </button>
  {% elsif product.variants.size == 1 and product.requires_selling_plan == false %}
    {% form 'product', product,
      id: product_form_id,
      class: 'product-card-form',
      data-cart-source: 'product-card'
    %}
      <input type="hidden" name="id" value="{{ selected_variant.id }}">
      <button
        type="submit"
        name="add"
        class="btn {{ block.settings.button_size }} {{ block.settings.button_style }}"
      >
        {{ 'products.form.add_to_cart' | t }}
      </button>
    {% endform %}
  {% else %}
    <span
      class="btn {{ block.settings.button_size }} {{ block.settings.button_style }}"
    >
      {{ 'products.form.select_options' | t }}
    </span>
  {% endif %}
</div>

{% schema %}
{
  "name": "Product form",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "btn-accent-solid", "label": "Accent solid" },
        { "value": "btn-accent-outline", "label": "Accent outline" },
        { "value": "btn-text-solid", "label": "Text solid" },
        { "value": "btn-text-outline", "label": "Text outline" }
      ],
      "default": "btn-accent-solid"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Button size",
      "options": [
        { "value": "btn-sm", "label": "Small" },
        { "value": "btn-md", "label": "Medium" },
        { "value": "btn-lg", "label": "Large" }
      ],
      "default": "btn-sm"
    }
  ],
  "presets": [
    {
      "name": "Product form",
      "category": "Product"
    }
  ]
}
{% endschema %}
