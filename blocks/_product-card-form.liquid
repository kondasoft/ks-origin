{% liquid
  assign product = closest.product
  assign selected_variant = product.selected_or_first_available_variant
  assign quantity_min = selected_variant.quantity_rule.min | default: 1
  assign quantity_increment = selected_variant.quantity_rule.increment | default: 1
  assign cart_quantity = cart | item_count_for_variant: selected_variant.id
  assign quantity_max = blank
  assign quantity_unavailable = false

  if selected_variant.quantity_rule.max != null
    assign quantity_max = selected_variant.quantity_rule.max | minus: cart_quantity | at_least: 0
  endif
  if selected_variant.inventory_management != blank and selected_variant.inventory_policy == 'deny'
    assign inventory_remaining = selected_variant.inventory_quantity | minus: cart_quantity | at_least: 0
    if quantity_max == blank
      assign quantity_max = inventory_remaining
    else
      assign quantity_max = quantity_max | at_most: inventory_remaining
    endif
  endif
  if quantity_max != blank
    assign quantity_max = quantity_max | divided_by: quantity_increment | times: quantity_increment
    if quantity_max < quantity_min
      assign quantity_unavailable = true
    endif
  endif
  assign product_form_id = 'product-card-form-' | append: block.id | append: '-' | append: product.id
%}

<div
  class="product-card-form-block block-spacing"
  data-product-root
  style="
    --pt: {{ block.settings.pt | divided_by: 16.0 | append: 'em' }};
    --pb: {{ block.settings.pb | divided_by: 16.0 | append: 'em' }};
  "
  {{ block.shopify_attributes }}
>
  {% if product == blank %}
    <button
      type="button"
      class="btn {{ block.settings.button_size }} {{ block.settings.button_style }}"
    >
      {{ 'products.form.add_to_cart' | t }}
    </button>
  {% elsif product.available == false %}
    <button
      type="button"
      class="btn {{ block.settings.button_size }} {{ block.settings.button_style }}"
      disabled
    >
      {{ 'products.form.sold_out' | t }}
    </button>
  {% elsif product.requires_selling_plan %}
    {% comment %}Quick add has no app blocks to choose a required subscription plan.{% endcomment %}
    <a
      href="{{ product.url }}"
      class="btn {{ block.settings.button_size }} {{ block.settings.button_style }}"
      data-product-card-link
    >
      {{ 'products.form.select_options' | t }}
    </a>
  {% elsif product.variants.size == 1 %}
    {% render 'product-variant-picker', product: product, id: block.id, data_only: true %}
    <theme-product-form data-source="product-card" data-product-buy-buttons>
      {% form 'product', product,
        id: product_form_id,
        class: 'product-card-form'
      %}
        <input type="hidden" name="id" value="{{ selected_variant.id }}">
        <input type="hidden" name="quantity" value="{{ quantity_min }}" min="{{ quantity_min }}" step="{{ quantity_increment }}" {% if quantity_max != blank %}max="{{ quantity_max }}"{% endif %} data-quantity-input>
        <button
          type="submit"
          name="add"
          data-add-to-cart-button
          {% if quantity_unavailable %}disabled{% endif %}
          class="btn {{ block.settings.button_size }} {{ block.settings.button_style }}"
        >
          {{ 'products.form.add_to_cart' | t }}
        </button>
      {% endform %}
    </theme-product-form>
  {% else %}
    <button
      type="button"
      class="btn {{ block.settings.button_size }} {{ block.settings.button_style }}"
      aria-label="{{ 'products.quick_add.button_label' | t: product: product.title | escape }}"
      aria-controls="quick-add-dialog"
      aria-haspopup="dialog"
      data-quick-add-url="{{ product.url }}"
    >
      {{ 'products.quick_add.button' | t }}
    </button>
  {% endif %}
</div>

{% schema %}
{
  "name": "Product form",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "btn-accent-solid", "label": "Accent solid" },
        { "value": "btn-accent-outline", "label": "Accent outline" },
        { "value": "btn-text-solid", "label": "Text solid" },
        { "value": "btn-text-outline", "label": "Text outline" }
      ],
      "default": "btn-accent-solid"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Button size",
      "options": [
        { "value": "btn-sm", "label": "Small" },
        { "value": "btn-md", "label": "Medium" },
        { "value": "btn-lg", "label": "Large" }
      ],
      "default": "btn-sm"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product form",
      "category": "Product"
    }
  ]
}
{% endschema %}
