{% layout none %}

{%- assign formatted_balance = gift_card.balance | money_without_trailing_zeros | strip_html -%}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{{ 'gift_cards.issued.title' | t: value: formatted_balance, shop: shop.name }}</title>
    <meta name="description" content="{{ 'gift_cards.issued.subtext' | t | escape }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {% endif %}

    {{ content_for_header }}
    {% render 'theme-assets' %}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    <script src="{{ 'gift-card.js' | asset_url }}" type="module"></script>

    {% style %}
      /*
        Gift card
      */
      body {
        color: {{ settings.color_text }};
        background-color: {{ settings.color_background }};
      }

      .gift-card {
        width: calc(100% - 2rem);
        max-width: 560px;
        margin-inline: auto;
        padding-block: 3rem;
        text-align: center;
      }

      .gift-card-image {
        display: block;
        max-width: 100%;
        height: auto;
        margin: 2rem auto;
      }

      .gift-card-code {
        padding: 1rem;
        overflow-wrap: anywhere;
        font-size: var(--fs-xl);
        font-weight: 500;
        background-color: {{ settings.color_surface }};
        border: 1px dashed {{ settings.color_text }};
        border-radius: var(--border-radius);
      }

      .gift-card-actions {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        margin-block-start: 2rem;
      }

      .gift-card-qr-code {
        display: block;
        width: 160px;
        height: 160px;
        margin: 2rem auto 0;
      }

      .gift-card-qr-code img {
        display: block;
        width: 100%;
        height: 100%;
      }

      .gift-card-qr-code canvas {
        display: block;
        width: 100%;
        height: 100%;
      }

      .gift-card-buttons {
        justify-content: center;
      }

      .gift-card-copy {
        display: contents;
      }
    {% endstyle %}
  </head>

  <body>
    <main class="gift-card">
      <h1>{{ shop.name }}</h1>
      <p>{{ 'gift_cards.issued.subtext' | t }}</p>

      <img
        class="gift-card-image"
        src="{{ 'gift-card/card.svg' | shopify_asset_url }}"
        alt=""
        width="334"
        height="200"
      >

      <h2>{{ gift_card.balance | money_with_currency }}</h2>

      {% if gift_card.enabled == false or gift_card.expired %}
        <p>{{ 'gift_cards.issued.expired' | t }}</p>
      {% endif %}

      {% if gift_card.expires_on %}
        {%- assign expires_on = gift_card.expires_on | date: '%B %e, %Y' -%}
        <p>{{ 'gift_cards.issued.expiration_date' | t: expires_on: expires_on }}</p>
      {% endif %}

      <p>{{ 'gift_cards.issued.how_to_use_gift_card' | t }}</p>
      <p class="gift-card-code">
        <span class="visually-hidden">{{ 'gift_cards.issued.code' | t }}:</span>
        {{ gift_card.code | format_code }}
      </p>

      <gift-card-qr-code
        class="gift-card-qr-code"
        role="img"
        aria-label="{{ 'gift_cards.issued.qr_image_alt' | t | escape }}"
        data-identifier="{{ gift_card.qr_identifier | escape }}"
      ></gift-card-qr-code>

      <div class="gift-card-actions">
        <div class="gift-card-buttons btn-group">
          <gift-card-copy class="gift-card-copy">
            <input
              class="visually-hidden"
              type="text"
              value="{{ gift_card.code | escape }}"
              tabindex="-1"
              disabled
              data-gift-card-copy-input
            >
            <button
              class="btn btn-wide btn-accent-solid btn-md"
              type="button"
              data-gift-card-copy-button
              data-copy-text="{{ 'gift_cards.issued.copy_code' | t | escape }}"
              data-copied-text="{{ 'gift_cards.issued.copy_code_success' | t | escape }}"
            >
              {{ 'gift_cards.issued.copy_code' | t }}
            </button>
            <span
              class="visually-hidden"
              role="status"
              aria-live="polite"
              aria-atomic="true"
              data-gift-card-copy-status
            ></span>
          </gift-card-copy>

          <a class="btn btn-wide btn-text-outline btn-md" href="{{ shop.url }}">
            {{ 'gift_cards.issued.shop_link' | t }}
          </a>
        </div>

        {% if gift_card.pass_url %}
          <a href="{{ gift_card.pass_url }}">
            <img
              src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
              alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}"
              width="120"
              height="40"
            >
          </a>
        {% endif %}
      </div>
    </main>
  </body>
</html>
