[
  {
    "name": "theme_info",
    "theme_name": "KS Origin",
    "theme_version": "1.0.0",
    "theme_author": "KondaSoft",
    "theme_documentation_url": "https://github.com/kondasoft/ks-origin",
    "theme_support_url": "https://github.com/kondasoft/ks-origin/issues"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Color palette",
        "info": "Create a reusable palette based on your brand colors, then use those colors in sections or assign them to the theme colors below."
      },
      {
        "type": "color_palette",
        "id": "colors",
        "default": {
          "background": "#FFFFFF",
          "text": "#0A0A0A",
          "surface": "#EBEBEC",
          "accent": "#2563EB"
        }
      },
      {
        "type": "header",
        "content": "Theme colors",
        "info": "Set the global colors used by theme elements. Sections with their own color settings are configured separately."
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "{{ settings.colors.background }}"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "{{ settings.colors.text }}"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface",
        "default": "{{ settings.colors.surface }}"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "{{ settings.colors.accent }}"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Headings",
        "default": "assistant_n7"
      },
      {
        "type": "range",
        "id": "heading_size_scale",
        "label": "Base heading size",
        "min": 80,
        "max": 150,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "body_size_scale",
        "label": "Base body size",
        "min": 90,
        "max": 110,
        "step": 1,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "select",
        "id": "container_width",
        "label": "Container width",
        "options": [
          { "value": "container-narrow", "label": "Narrow" },
          { "value": "container-normal", "label": "Normal" },
          { "value": "container-wide", "label": "Wide" }
        ],
        "default": "container-narrow",
        "info": "Narrow: 1440px, Normal: 1920px, Wide: 2400px"
      }
    ]
  },
  {
    "name": "Borders",
    "settings": [
      {
        "type": "range",
        "id": "border_opacity",
        "label": "Border opacity",
        "min": 0,
        "max": 100,
        "step": 5,
        "unit": "%",
        "default": 20
      },
      {
        "type": "range",
        "id": "border_radius",
        "label": "Border radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 0
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "32 x 32 px PNG recommended."
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Drawer" },
          { "value": "page", "label": "Page" }
        ],
        "default": "drawer",
        "info": "Choose whether cart links open a drawer or the cart page."
      },
      {
        "type": "header",
        "content": "Cart items",
        "info": "These settings apply to both the cart drawer and cart page."
      },
      {
        "type": "select",
        "id": "cart_item_image_ratio",
        "label": "Image aspect ratio",
        "options": [
          { "group": "Adapt", "value": "adapt", "label": "Adapt to image" },
          { "group": "Square", "value": "square", "label": "Square (1:1)" },
          { "group": "Horizontal", "value": "landscape", "label": "Landscape (4:3)" },
          { "group": "Horizontal", "value": "widescreen", "label": "Widescreen (16:9)" },
          { "group": "Vertical", "value": "portrait", "label": "Portrait (3:4)" },
          { "group": "Vertical", "value": "vertical", "label": "Vertical (9:16)" }
        ],
        "default": "square"
      },
      {
        "type": "select",
        "id": "cart_item_title_font_family",
        "label": "Title font family",
        "options": [
          { "value": "heading", "label": "Heading" },
          { "value": "body", "label": "Body" }
        ],
        "default": "heading"
      },
      {
        "type": "select",
        "id": "cart_item_title_size",
        "label": "Title size",
        "options": [
          { "value": "fs-xs", "label": "XS" },
          { "value": "fs-sm", "label": "SM" },
          { "value": "fs-md", "label": "MD" },
          { "value": "fs-lg", "label": "LG" },
          { "value": "fs-xl", "label": "XL" }
        ],
        "default": "fs-md"
      },
      {
        "type": "header",
        "content": "Cart options",
        "info": "These settings apply to both the cart drawer and cart page."
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Show order note",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_show_discount",
        "label": "Show discount code",
        "default": true
      },
      {
        "type": "header",
        "content": "Cart footer",
        "info": "These settings apply to both the cart drawer and cart page."
      },
      {
        "type": "select",
        "id": "cart_subtotal_size",
        "label": "Subtotal size",
        "options": [
          { "value": "fs-md", "label": "Medium" },
          { "value": "fs-lg", "label": "Large" },
          { "value": "fs-xl", "label": "Extra large" },
          { "value": "fs-2xl", "label": "2X large" },
          { "value": "fs-3xl", "label": "3X large" }
        ],
        "default": "fs-lg"
      },
      {
        "type": "checkbox",
        "id": "cart_show_tax_information",
        "label": "Show tax and shipping information",
        "default": true
      },
      {
        "type": "select",
        "id": "cart_checkout_button_color",
        "label": "Checkout button color",
        "options": [
          { "value": "btn-accent-solid", "label": "Accent" },
          { "value": "btn-text-solid", "label": "Text" }
        ],
        "default": "btn-accent-solid"
      },
      {
        "type": "select",
        "id": "cart_checkout_button_size",
        "label": "Checkout button size",
        "options": [
          { "value": "btn-md", "label": "Medium" },
          { "value": "btn-lg", "label": "Large" }
        ],
        "default": "btn-md"
      },
      {
        "type": "checkbox",
        "id": "cart_show_dynamic_checkout_buttons",
        "label": "Show dynamic checkout buttons",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "cart_show_view_cart_button",
        "label": "Show View cart button",
        "default": false
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "paragraph",
        "content": "Enter the full URL for each social media profile below (for example, https://www.facebook.com/shopify)."
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook",
        "default": "https://www.facebook.com/shopify"
      },
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram",
        "default": "https://www.instagram.com/shopify"
      },
      {
        "type": "text",
        "id": "social_threads",
        "label": "Threads",
        "default": "https://www.threads.com/@shopify"
      },
      {
        "type": "text",
        "id": "social_x",
        "label": "X",
        "default": "https://x.com/shopify"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok",
        "default": "https://www.tiktok.com/@shopify"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest",
        "default": "https://www.pinterest.com/shopify"
      },
      {
        "type": "text",
        "id": "social_snapchat",
        "label": "Snapchat",
        "default": "https://www.snapchat.com/add/shopify"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube",
        "default": "https://www.youtube.com/@shopify"
      },
      {
        "type": "text",
        "id": "social_linkedin",
        "label": "LinkedIn",
        "default": "https://www.linkedin.com/company/shopify"
      }
    ]
  }
]
