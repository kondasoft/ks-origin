<!doctype html>
<html
  lang="{{ request.locale.iso_code }}"
  data-design-mode="{{ request.design_mode }}"
  data-page-type="{{ request.page_type }}"
  data-template-name="{{ template.name }}"
  data-template-suffix="{{ template.suffix }}">
  <head>
    {% render 'theme-head' %}
    {{ content_for_header }}
    {% render 'theme-assets' %}
  </head>

  <body>
    <a class="skip-link" href="#main">
      {{ 'accessibility.skip_to_content2' | t }}
    </a>

    <div
      id="page-container"
      class="container">
      <div id="header-group">
        {% sections 'header-group' %}
      </div>

      <main id="main">
        {{ content_for_layout }}
      </main>

      <div id="footer-group">
        {% sections 'footer-group' %}
      </div>
    </div>

    {% render 'ai-tools-dialog' %}
    {% render 'search-dialog' %}
    {% render 'cart-dialog' %}
  </body>
</html>
