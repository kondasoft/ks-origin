<!doctype html>
<html
  lang="{{ request.locale.iso_code }}"
  data-design-mode="{{ request.design_mode }}"
  data-page-type="{{ request.page_type }}"
  data-template-name="{{ template.name }}"
  data-template-suffix="{{ template.suffix }}">
  <head>
    {% render 'theme-head' %}
    {{ content_for_header }}
    {% render 'theme-assets' %}
  </head>

  <body>
    <a class="skip-link" href="#main">
      {{ 'accessibility.skip_to_content' | t }}
    </a>

    <div id="header-group">
      {% sections 'header-group' %}
    </div> 

    <main id="main">
      <div class="typography-preview">
        <h1>Heading 1</h1>
        <h2>Heading 2</h2>
        <h3>Heading 3</h3>
        <h4>Heading 4</h4>
        <h5>Heading 5</h5>
        <h6>Heading 6</h6>

        <p>
          This is a paragraph with <strong>bold text</strong>, <em>italic text</em>, and
          <a href="{{ routes.root_url }}">a text link</a>.
        </p>

        <button type="button">Button</button>

        <ul>
          <li>Unordered list item</li>
          <li>Unordered list item</li>
          <li>Unordered list item</li>
        </ul>

        <ol>
          <li>Ordered list item</li>
          <li>Ordered list item</li>
          <li>Ordered list item</li>
        </ol>

        <blockquote>
          <p>This is a blockquote used to preview longer quoted content.</p>
          <cite>Quote source</cite>
        </blockquote>

        <table>
          <caption>
            Table caption
          </caption>
          <thead>
            <tr>
              <th scope="col">Product</th>
              <th scope="col">Quantity</th>
              <th scope="col">Price</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Example product</td>
              <td>1</td>
              <td>$10.00</td>
            </tr>
            <tr>
              <td>Another product</td>
              <td>2</td>
              <td>$20.00</td>
            </tr>
          </tbody>
        </table>
      </div>

      {{ content_for_layout }}
    </main>

    <div id="footer-group">
      {% sections 'footer-group' %}
    </div>

    {% render 'search-dialog' %}
    {% render 'cart-dialog' %}
  </body>
</html>
