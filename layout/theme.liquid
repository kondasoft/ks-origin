<!doctype html>
<html
  lang="{{ request.locale.iso_code }}"
  data-page-type="{{ request.page_type }}"
  data-template-name="{{ template.name }}"
  data-template-suffix="{{ template.suffix }}"
  data-cart-url="{{ routes.cart_url }}"
  data-cart-error-text="{{ 'cart.error' | t | escape }}"
  data-design-mode="{{ request.design_mode }}">
  <head>
    {% render 'theme-head' %}
    {{ content_for_header }}
    {% render 'theme-assets' %}
  </head>

  <body>
    <a class="skip-link" href="#main">
      {{ 'accessibility.skip_to_content' | t }}
    </a>

    <div id="header-group">
      {% sections 'header-group' %}
    </div> 

    <main id="main">
      {{ content_for_layout }}
    </main>

    <div id="footer-group">
      {% sections 'footer-group' %}
    </div>

    {% liquid
      render 'search-dialog'
      render 'cart-dialog'
      render 'localization-countries-dialog'
      render 'localization-languages-dialog'
      render 'modal-test-dialog' 
    %}

    {% comment %}
      Announces cart updates to screen readers without moving focus.
    {% endcomment %}
    <div
      class="visually-hidden"
      role="status"
      aria-live="polite"
      aria-atomic="true"
      data-cart-live-region
    ></div>
  </body>
</html>
