<theme-dialog>
  <dialog
    id="modal-test-dialog"
    class="dialog modal modal-test-dialog"
    aria-labelledby="modal-test-dialog-title"
  >
    <div class="dialog-header">
      <h2 id="modal-test-dialog-title" class="dialog-title">
        {{ 'general.test_modal' | t }}
      </h2>

      <button
        class="icon-button dialog-close"
        type="button"
        data-dialog-close
        aria-label="{{ 'accessibility.close' | t }}"
      >
        {% render 'svg-icons', icon: 'close' %}
      </button>
    </div>

    <div class="dialog-body"></div>
  </dialog>
</theme-dialog>
