{% liquid
  assign icon_size = icon_size | default: 22
  assign body_size_scale = settings.body_size_scale | default: 100 | divided_by: 100.0
  assign scaled_icon_size = icon_size | times: body_size_scale
  assign stroke_width = stroke_width | default: 1.5
%}

{% case icon %}
  {% when 'menu' %}
    <svg aria-hidden="true" class="svg-icon svg-icon-menu" width="{{ scaled_icon_size }}" height="{{ scaled_icon_size }}" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <line x1="3" y1="12" x2="21" y2="12" stroke="currentColor" stroke-linecap="round" stroke-width="{{ stroke_width }}"></line>
      <line x1="3" y1="6" x2="21" y2="6" stroke="currentColor" stroke-linecap="round" stroke-width="{{ stroke_width }}"></line>
      <line x1="3" y1="18" x2="21" y2="18" stroke="currentColor" stroke-linecap="round" stroke-width="{{ stroke_width }}"></line>
    </svg>
  {% when 'search' %}
    <svg aria-hidden="true" class="svg-icon svg-icon-search" width="{{ scaled_icon_size }}" height="{{ scaled_icon_size }}" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="9" cy="9" r="4.75" stroke="currentColor" stroke-width="{{ stroke_width }}"></circle>
      <path d="m12.5 12.5 3.25 3.25" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="{{ stroke_width }}"></path>
    </svg>
  {% when 'account' %}
    <svg aria-hidden="true" class="svg-icon svg-icon-account" width="{{ scaled_icon_size }}" height="{{ scaled_icon_size }}" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="10" cy="6.5" r="2.75" stroke="currentColor" stroke-width="{{ stroke_width }}"></circle>
      <path d="m5.172 14.591-.437.786a.588.588 0 0 0 .514.873h9.502a.588.588 0 0 0 .514-.873l-.437-.786a5.523 5.523 0 0 0-9.656 0" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="{{ stroke_width }}"></path>
    </svg>
  {% when 'bag' %}
    <svg aria-hidden="true" class="svg-icon svg-icon-bag" width="{{ scaled_icon_size }}" height="{{ scaled_icon_size }}" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M3.392 6.875h13.216v8.016c0 .567-.224 1.112-.624 1.513-.4.402-.941.627-1.506.627H5.522a2.13 2.13 0 0 1-1.506-.627 2.15 2.15 0 0 1-.624-1.513zM8.818 2.969h2.333c.618 0 1.211.247 1.649.686a2.35 2.35 0 0 1 .683 1.658v1.562H6.486V5.313c0-.622.246-1.218.683-1.658a2.33 2.33 0 0 1 1.65-.686" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="{{ stroke_width }}"></path>
    </svg>
  {% when 'close' %}
    <svg aria-hidden="true" class="svg-icon svg-icon-close" width="{{ scaled_icon_size }}" height="{{ scaled_icon_size }}" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M5 5l10 10M15 5 5 15" stroke="currentColor" stroke-linecap="round" stroke-width="{{ stroke_width }}"></path>
    </svg>
  {% when 'arrow-left' %}
    <svg aria-hidden="true" class="svg-icon svg-icon-arrow-left" width="{{ scaled_icon_size }}" height="{{ scaled_icon_size }}" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M16 10H5m4-4-4 4 4 4" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="{{ stroke_width }}"></path>
    </svg>
  {% when 'arrow-right' %}
    <svg aria-hidden="true" class="svg-icon svg-icon-arrow-right" width="{{ scaled_icon_size }}" height="{{ scaled_icon_size }}" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M4 10h11m-4-4 4 4-4 4" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="{{ stroke_width }}"></path>
    </svg>
  {% when 'chevron-down' %}
    <svg aria-hidden="true" class="svg-icon svg-icon-chevron-down" width="{{ scaled_icon_size }}" height="{{ scaled_icon_size }}" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="m5.5 7.5 4.5 4.5 4.5-4.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="{{ stroke_width }}"></path>
    </svg>
  {% when 'play' %}
    <svg aria-hidden="true" class="svg-icon svg-icon-play" width="{{ scaled_icon_size }}" height="{{ scaled_icon_size }}" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="m7 5 7 5-7 5z" fill="currentColor"></path>
    </svg>
  {% when 'filter' %}
    <svg aria-hidden="true" class="svg-icon svg-icon-filter" width="{{ scaled_icon_size }}" height="{{ scaled_icon_size }}" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="{{ stroke_width }}"></polygon>
    </svg>
  {% when 'sliders' %}
    <svg aria-hidden="true" class="svg-icon svg-icon-sliders" width="{{ scaled_icon_size }}" height="{{ scaled_icon_size }}" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M4 21v-7m0-4V3m8 18v-9m0-4V3m8 18v-5m0-4V3M1 14h6m2-6h6m2 8h6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="{{ stroke_width }}"></path>
    </svg>
  {% when 'translate' %}
    <svg aria-hidden="true" class="svg-icon svg-icon-translate" width="{{ scaled_icon_size }}" height="{{ scaled_icon_size }}" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="m5 8 6 6M4 14l6-6 2-3M2 5h12M7 2h1m14 20-5-10-5 10m2-4h8" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="{{ stroke_width }}"></path>
    </svg>
  {% when 'share' %}
    <svg aria-hidden="true" class="svg-icon svg-icon-share" width="{{ scaled_icon_size }}" height="{{ scaled_icon_size }}" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="18" cy="5" r="3" stroke="currentColor" stroke-width="{{ stroke_width }}"></circle>
      <circle cx="6" cy="12" r="3" stroke="currentColor" stroke-width="{{ stroke_width }}"></circle>
      <circle cx="18" cy="19" r="3" stroke="currentColor" stroke-width="{{ stroke_width }}"></circle>
      <path d="m8.59 13.51 6.82 3.98M15.41 6.51 8.59 10.49" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="{{ stroke_width }}"></path>
    </svg>
{% endcase %}
