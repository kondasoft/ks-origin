<script src="{{ 'base.js' | asset_url }}" type="module"></script>
<script src="{{ 'components.js' | asset_url }}" type="module"></script>
<script src="{{ 'product-form.js' | asset_url }}" type="module"></script>
<script src="{{ 'cart.js' | asset_url }}" type="module"></script>
<script src="{{ 'quick-add.js' | asset_url }}" type="module"></script>

{% if request.page_type == 'product' %}
  <script src="{{ 'product-gallery.js' | asset_url }}" type="module"></script>
  <script src="{{ 'product-variant-picker.js' | asset_url }}" type="module"></script>
{% endif %}

{% if request.page_type == 'collection' or request.page_type == 'search' %}
