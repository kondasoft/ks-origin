{% form 'storefront_password', class: 'password-dialog-form' %}
  <theme-dialog>
    <dialog
      id="password-dialog"
      class="dialog modal password-dialog"
      aria-labelledby="password-dialog-title"
      {% if form.errors %}data-open-on-load{% endif %}
    >
      <div class="dialog-header">
        <h2 id="password-dialog-title" class="dialog-title">
          {{ 'general.password.enter_password' | t }}
        </h2>

        <button
          class="icon-button dialog-close"
          type="button"
          data-dialog-close
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {% render 'svg-icons', icon: 'close' %}
        </button>
      </div>

      <div class="dialog-body">
        {% if form.errors %}
          <div
            id="password-dialog-error"
            class="password-dialog-error alert alert-with-icon alert-error"
            role="alert"
          >
            {{ 'general.password.incorrect_password' | t }}
          </div>
        {% endif %}

        <div class="password-dialog-fields">
          <div>
            <label for="PasswordInput">
              {{ 'general.password.password' | t }}
            </label>
            <input
              id="PasswordInput"
              class="input"
              type="password"
              name="password"
              autocomplete="current-password"
              required
              autofocus
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="password-dialog-error"
              {% endif %}
            >
          </div>

          <button class="password-dialog-submit btn btn-wide btn-md btn-accent-solid" type="submit">
            {{ 'general.password.submit' | t }}
          </button>
        </div>
      </div>
    </dialog>
  </theme-dialog>
{% endform %}
