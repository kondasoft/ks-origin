<mobile-menu-dialog>
  <div
    class="mobile-menu-backdrop"
    data-mobile-menu-backdrop
    aria-hidden="true"
    hidden
  ></div>

  <nav
    id="mobile-menu-dialog"
    class="mobile-menu-panel"
    data-mobile-menu-panel
    aria-label="{{ 'accessibility.navigation' | t }}"
    hidden
  >
    <div class="mobile-menu-body">
      {% if menu.links.size > 0 %}
        <ul class="mobile-menu-list">
            {% for link in menu.links %}
              <li>
                {% if link.levels == 0 %}
                  <a
                    class="mobile-menu-link{% if link.active %} active{% endif %}"
                    href="{{ link.url }}"
                    {% if link.current %}aria-current="page"{% endif %}
                  >
                    {{ link.title }}
                  </a>
                {% else %}
                  {% assign submenu_id = 'mobile-menu-' | append: section_id | append: '-level-2-' | append: forloop.index %}
                  <button
                    class="mobile-menu-link{% if link.active or link.child_active %} active{% endif %}"
                    type="button"
                    aria-controls="{{ submenu_id }}"
                    aria-expanded="false"
                    data-submenu-toggle
                  >
                    <span>{{ link.title }}</span>
                    {% render 'svg-icons', icon: 'arrow-right', icon_size: 18 %}
                  </button>

                  <ul
                    id="{{ submenu_id }}"
                    class="mobile-menu-submenu"
                    hidden
                  >
                    <li>
                      <button
                        class="mobile-menu-link mobile-menu-back"
                        type="button"
                        data-submenu-back
                        aria-label="{{ 'accessibility.back_to_menu' | t: title: link.title }}"
                      >
                        {% render 'svg-icons', icon: 'arrow-left', icon_size: 18 %}
                        <span>{{ link.title }}</span>
                      </button>
                    </li>

                    {% for child_link in link.links %}
                      <li>
                        {% if child_link.levels == 0 %}
                          <a
                            class="mobile-menu-link{% if child_link.active %} active{% endif %}"
                            href="{{ child_link.url }}"
                            {% if child_link.current %}aria-current="page"{% endif %}
                          >
                            {{ child_link.title }}
                          </a>
                        {% else %}
                          {% assign child_submenu_id = 'mobile-menu-' | append: section_id | append: '-level-3-' | append: forloop.parentloop.index | append: '-' | append: forloop.index %}
                          <button
                            class="mobile-menu-link{% if child_link.active or child_link.child_active %} active{% endif %}"
                            type="button"
                            aria-controls="{{ child_submenu_id }}"
                            aria-expanded="false"
                            data-submenu-toggle
                          >
                            <span>{{ child_link.title }}</span>
                            {% render 'svg-icons', icon: 'arrow-right', icon_size: 18 %}
                          </button>

                          <ul
                            id="{{ child_submenu_id }}"
                            class="mobile-menu-submenu"
                            hidden
                          >
                            <li>
                              <button
                                class="mobile-menu-link mobile-menu-back"
                                type="button"
                                data-submenu-back
                                aria-label="{{ 'accessibility.back_to_menu' | t: title: child_link.title }}"
                              >
                                {% render 'svg-icons', icon: 'arrow-left', icon_size: 18 %}
                                <span>{{ child_link.title }}</span>
                              </button>
                            </li>

                            {% for grandchild_link in child_link.links %}
                              <li>
                                <a
                                  class="mobile-menu-link{% if grandchild_link.active %} active{% endif %}"
                                  href="{{ grandchild_link.url }}"
                                  {% if grandchild_link.current %}aria-current="page"{% endif %}
                                >
                                  {{ grandchild_link.title }}
                                </a>
                              </li>
                            {% endfor %}
                          </ul>
                        {% endif %}
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </li>
            {% endfor %}
        </ul>
      {% endif %}

      {% if localization.available_languages.size > 1 or localization.available_countries.size > 1 %}
        <ul
          id="header-mobile-secondary-menu"
          class="mobile-menu-secondary-list"
          aria-label="{{ 'accessibility.secondary_menu' | t }}"
        >
          {% if localization.available_languages.size > 1 %}
            <li>
              <button
                class="mobile-menu-link mobile-menu-secondary-link"
                type="button"
                data-toggle="languages-dialog"
                aria-controls="languages-dialog"
                aria-haspopup="dialog"
              >
                {% render 'svg-icons', icon: 'translate', icon_size: 18 %}
                <span class="visually-hidden">
                  {{ 'general.localization.language' | t }}
                </span>
                <span class="mobile-menu-secondary-text">
                  {{ localization.language.endonym_name | capitalize }}
                  <small>({{ localization.language.iso_code }})</small>
                </span>
              </button>
            </li>
          {% endif %}

          {% if localization.available_countries.size > 1 %}
            <li>
              <button
                class="mobile-menu-link mobile-menu-secondary-link"
                type="button"
                data-toggle="countries-dialog"
                aria-controls="countries-dialog"
                aria-haspopup="dialog"
              >
                <span class="mobile-menu-localization-image" aria-hidden="true">
                  {{ localization.country | image_url: width: 18, height: 18 | image_tag: loading: 'lazy' }}
                </span>
                <span class="visually-hidden">
                  {{ 'general.localization.country' | t }}
                </span>
                <span class="mobile-menu-secondary-text">
                  {{ localization.country.name }}
                  <small>
                    ({{ localization.country.currency.iso_code }}
                    {{ localization.country.currency.symbol }})
                  </small>
                </span>
              </button>
            </li>
          {% endif %}
        </ul>
      {% endif %}
    </div>

    {% render 'social-icons',
      icon_size: 18,
      wrapper_class: 'mobile-menu-footer'
    %}
  </nav>
</mobile-menu-dialog>
