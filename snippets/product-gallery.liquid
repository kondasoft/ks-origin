{% doc %}
Renders the product media gallery and its optional full-screen viewer for product and Featured product sections.

@param {section} [section] - A section override, otherwise the current section context is used.
@param {product} [product] - A product override, otherwise the current or section-selected product is used.

@example
{% render 'product-gallery' %}
{% enddoc %}

{% liquid
  assign gallery_product = product | default: section.settings.product
  assign gallery_media = gallery_product.media
  assign gallery_models = gallery_media | where: 'media_type', 'model'
  assign gallery_count = gallery_media.size
  assign gallery_media_ratio = section.settings.gallery_media_ratio | default: 'adapt'
  assign gallery_selected_variant = gallery_product.selected_or_first_available_variant
  assign gallery_initial_media_id = gallery_selected_variant.featured_media.id | default: gallery_product.featured_media.id
  assign gallery_initial_media = gallery_product.media | where: 'id', gallery_initial_media_id | first
  assign gallery_initial_preview_image = gallery_initial_media.preview_image | default: gallery_product.featured_image
  assign gallery_initial_index = 0
  assign gallery_aspect_ratio = '1 / 1'
  assign gallery_stage_class = 'product-gallery-stage'
  assign gallery_viewer_id = 'ProductGalleryViewer-' | append: section.id

  for media in gallery_media
    if media.id == gallery_initial_media_id
      assign gallery_initial_index = forloop.index0
      break
    endif
  endfor

  if gallery_media_ratio == 'adapt'
    if gallery_initial_preview_image != blank
      assign gallery_aspect_ratio = gallery_initial_preview_image.width | append: ' / ' | append: gallery_initial_preview_image.height
    endif
  else
    assign gallery_stage_class = gallery_stage_class | append: ' aspect-ratio-' | append: gallery_media_ratio
  endif
%}

<product-gallery
  class="product-gallery"
  data-transition="{{ section.settings.gallery_transition }}"
  data-media-ratio="{{ gallery_media_ratio }}"
  data-video-fit="{{ section.settings.gallery_video_fit | default: 'contain' }}"
  data-video-autoplay="{{ section.settings.gallery_video_autoplay }}"
  style="--product-gallery-aspect-ratio: {{ gallery_aspect_ratio }};"
>
  <div
    class="{{ gallery_stage_class }}"
    role="region"
    aria-label="{{ 'accessibility.product_gallery' | t }}"
    tabindex="0"
    data-product-gallery-stage
  >
    <ul
      class="product-gallery-track"
      role="list"
      data-product-gallery-track
      style="transform: translateX(-{{ gallery_initial_index | times: 100 }}%);"
    >
      {% assign gallery_index = 0 %}
      {% for media in gallery_media %}
        {% liquid
          assign media_alt = media.alt | default: gallery_product.title
          assign media_loading = 'lazy'
          assign media_fetchpriority = 'auto'

          if gallery_index == gallery_initial_index
            assign media_loading = 'eager'
            assign media_fetchpriority = 'high'
          endif
        %}
        <li
          class="product-gallery-slide{% if gallery_index == gallery_initial_index %} is-active{% endif %}"
          data-product-gallery-slide
          data-media-id="{{ media.id }}"
          data-media-type="{{ media.media_type }}"
          aria-hidden="{% if gallery_index == gallery_initial_index %}false{% else %}true{% endif %}"
          {% unless gallery_index == gallery_initial_index %}inert{% endunless %}
        >
          {% if media.media_type == 'image' %}
            {{ media
              | image_url: width: 2400
              | image_tag:
                alt: media_alt,
                class: 'product-gallery-image',
                widths: '320, 640, 960, 1280, 1600, 2000, 2400',
                sizes: '(min-width: 1200px) 50vw, 100vw',
                loading: media_loading,
                fetchpriority: media_fetchpriority
            }}
          {% else %}
            {% render 'product-media',
              media: media,
              product: gallery_product,
              autoplay: section.settings.gallery_video_autoplay,
              show_controls: section.settings.gallery_video_show_controls,
              media_width: 1200,
              sizes: '(min-width: 1200px) 50vw, 100vw',
              loading: media_loading
            %}
          {% endif %}
        </li>
        {% assign gallery_index = gallery_index | plus: 1 %}
      {% endfor %}

      {% if gallery_count == 0 %}
        <li class="product-gallery-slide is-active" data-product-gallery-slide aria-hidden="false">
          {% if gallery_product != blank %}
            {{ 'image' | placeholder_svg_tag: 'product-gallery-image placeholder-svg' }}
          {% else %}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'product-gallery-image placeholder-svg' }}
          {% endif %}
        </li>
      {% endif %}
    </ul>

    {% if section.settings.gallery_full_screen and gallery_count > 0 %}
      <button
        class="icon-button product-gallery-expand"
        type="button"
        data-viewer-open="{{ gallery_viewer_id }}"
        aria-controls="{{ gallery_viewer_id }}"
        aria-haspopup="dialog"
        aria-label="{{ 'accessibility.view_full_screen' | t }}"
      >
        {% render 'svg-icons', icon: 'expand', icon_size: 18 %}
      </button>
    {% endif %}

    {% if gallery_count > 1 and section.settings.gallery_show_navigation %}
      <div class="product-gallery-controls">
        <button
          class="icon-button"
          type="button"
          aria-label="{{ 'accessibility.previous_media' | t }}"
          data-product-gallery-previous
        >
          {% render 'svg-icons', icon: 'chevron-left', icon_size: 20 %}
        </button>
        <button
          class="icon-button"
          type="button"
          aria-label="{{ 'accessibility.next_media' | t }}"
          data-product-gallery-next
        >
          {% render 'svg-icons', icon: 'chevron-right', icon_size: 20 %}
        </button>
      </div>
    {% endif %}

    {% if gallery_count > 1 and section.settings.gallery_show_counter %}
      <span class="product-gallery-counter" aria-hidden="true" data-product-gallery-counter>
        {{ gallery_initial_index | plus: 1 }} / {{ gallery_count }}
      </span>
    {% endif %}
  </div>

  <span
    class="visually-hidden"
    aria-live="polite"
    data-product-gallery-status
    data-template="{{ 'accessibility.media_status' | t: index: '[index]', count: '[count]' | escape }}"
  ></span>

  {% if gallery_count > 1 and section.settings.gallery_show_thumbnails %}
    <ul class="product-gallery-thumbnails" role="list" data-product-gallery-thumbnails>
      {% assign gallery_index = 0 %}
      {% for media in gallery_media %}
        {% assign thumbnail_index = gallery_index | plus: 1 %}
        <li>
          <button
            class="product-gallery-thumbnail"
            type="button"
            data-product-gallery-thumbnail
            data-media-id="{{ media.id }}"
            data-index="{{ gallery_index }}"
            aria-label="{% if media.media_type == 'model' %}{{ 'accessibility.view_model' | t: index: thumbnail_index }}{% elsif media.media_type != 'image' %}{{ 'accessibility.view_video' | t: index: thumbnail_index }}{% else %}{{ 'accessibility.view_image' | t: index: thumbnail_index }}{% endif %}"
            {% if gallery_index == gallery_initial_index %}aria-current="true"{% endif %}
          >
            {{ media.preview_image
              | image_url: width: 280
              | image_tag:
                alt: '',
                class: 'product-gallery-thumbnail-image',
                widths: '80, 120, 160, 200, 240, 280',
                sizes: '(min-width: 600px) 140px, 56px',
                loading: 'lazy'
            }}
            {% if media.media_type != 'image' %}
              <span class="video-play-button product-gallery-thumbnail-play" aria-hidden="true">
                {% if media.media_type == 'model' %}
                  {% render 'svg-icons', icon: 'cube', icon_size: 16 %}
                {% else %}
                  {% render 'svg-icons', icon: 'play', icon_size: 16 %}
                {% endif %}
              </span>
            {% endif %}
          </button>
        </li>
        {% assign gallery_index = gallery_index | plus: 1 %}
      {% endfor %}
    </ul>
    <script>
      (() => {
        const thumbnailList = globalThis.document.currentScript.previousElementSibling;

        thumbnailList.updateThumbnailLayout = () => {
          const thumbnails = thumbnailList.querySelectorAll('[data-product-gallery-thumbnail]');
          const styles = globalThis.getComputedStyle(thumbnailList);
          const gap = Number.parseFloat(styles.columnGap) || 0;
          const padding =
            (Number.parseFloat(styles.paddingLeft) || 0) + (Number.parseFloat(styles.paddingRight) || 0);
          const minimumSize =
            Number.parseFloat(styles.getPropertyValue('--product-gallery-thumbnail-min')) || 50;
          const maximumSize =
            Number.parseFloat(styles.getPropertyValue('--product-gallery-thumbnail-max')) || 140;
          const availableWidth = thumbnailList.clientWidth - padding;
          const maximumVisible = Math.max(1, Math.floor((availableWidth + gap) / (minimumSize + gap)));
          const visibleCount = Math.min(thumbnails.length, maximumVisible);
          const thumbnailSize = Math.max(
            minimumSize,
            Math.min(maximumSize, (availableWidth - gap * (visibleCount - 1)) / visibleCount),
          );

          thumbnailList.style.setProperty('--product-gallery-thumbnail-size', `${thumbnailSize}px`);

          return visibleCount;
        };

        thumbnailList.updateThumbnailLayout();
      })();
    </script>
  {% endif %}
  {% if gallery_models.size > 0 %}
    <script type="application/json" data-product-models>{{ gallery_models | json }}</script>
  {% endif %}
  {% if section.settings.gallery_full_screen and gallery_count > 0 %}
    {% render 'product-gallery-viewer',
      viewer_id: gallery_viewer_id,
      product: gallery_product,
      transition: section.settings.gallery_transition,
      show_thumbnails: section.settings.gallery_full_screen_show_thumbnails
    %}
  {% endif %}
</product-gallery>
