{% doc %}
  Renders the shared filter drawer for collection and search result pages.

  @param {string} context - The result context: collection or search.
  @param {object} filters - The filters to render.
  @param {string} form_action - The URL submitted by the filter form.
  @param {string} sort_by - The current sort value.
  @param {string} clear_url - The URL that removes every active filter.
  @param {number} active_filter_count - The number of active filters.
  @param {number} result_count - The number of matching products or results.
  @param {string} section_id - The owning section ID used for dialog relationships.
  @param {string} [search_terms] - The current product-search terms.
{% enddoc %}

{% liquid
  assign dialog_id = 'FacetsDialog-' | append: section_id
  assign dialog_title_id = dialog_id | append: '-title'
  assign filters_label = 'general.facets.filters' | t
  assign price_from_label = 'general.facets.price_from' | t
  assign price_to_label = 'general.facets.price_to' | t
  assign clear_filters_label = 'general.facets.clear_filters' | t

  if context == 'search'
    assign show_results_label = 'search.show_results' | t: count: result_count
  else
    assign show_results_label = 'collections.show_products' | t: count: result_count
  endif
%}

<theme-dialog>
  <dialog
    id="{{ dialog_id }}"
    class="dialog drawer drawer-right facets-dialog"
    aria-labelledby="{{ dialog_title_id }}"
  >
    <div class="dialog-header">
      <h2 id="{{ dialog_title_id }}" class="dialog-title">
        {{ filters_label }}
      </h2>

      <button
        class="icon-button dialog-close"
        type="button"
        data-dialog-close
        aria-label="{{ 'accessibility.close' | t }}"
      >
        {% render 'svg-icons', icon: 'close' %}
      </button>
    </div>

    <facet-filters class="facets">
      <form
        class="facets-form"
        action="{{ form_action }}"
        method="get"
        data-facets-form
      >
        {% if context == 'search' %}
          <input type="hidden" name="q" value="{{ search_terms | escape }}">
          <input type="hidden" name="type" value="product">
          <input type="hidden" name="options[prefix]" value="last">
        {% endif %}
        <input type="hidden" name="sort_by" value="{{ sort_by }}">

        <div class="dialog-body">
          <div class="facets-groups">
            {% for filter in filters %}
              {% liquid
                assign filter_active_count = 0

                case filter.type
                  when 'boolean'
                    if filter.true_value != nil and filter.true_value.active
                      assign filter_active_count = filter_active_count | plus: 1
                    endif
                    if filter.false_value != nil and filter.false_value.active
                      assign filter_active_count = filter_active_count | plus: 1
                    endif
                  when 'list'
                    assign filter_active_count = filter.active_values.size
                  when 'price_range'
                    if filter.min_value.value != nil or filter.max_value.value != nil
                      assign filter_active_count = 1
                    endif
                endcase
              %}

              <theme-collapse class="theme-collapse facet">
                <details class="theme-collapse-details" open>
                  <summary class="theme-collapse-summary">
                    <span>
                      {{ filter.label | escape }}
                      {% if filter_active_count > 0 %}
                        ({{ filter_active_count }})
                      {% endif %}
                    </span>
                    <span class="theme-collapse-icon" aria-hidden="true">
                      {% render 'svg-icons', icon: 'chevron-down', icon_size: 18 %}
                    </span>
                  </summary>

                  <div class="theme-collapse-content">
                    {% case filter.type %}
                      {% when 'boolean' %}
                        <ul class="facets-list" role="list">
                          {% if filter.true_value != nil %}
                            <li>
                              <label class="facets-option">
                                <input
                                  type="checkbox"
                                  name="{{ filter.param_name }}"
                                  value="{{ filter.true_value.value }}"
                                  {% if filter.true_value.active %}checked{% endif %}
                                  {% if filter.true_value.count == 0 and filter.true_value.active == false %}disabled{% endif %}
                                >
                                <span>{{ filter.true_value.label | escape }}</span>
                                <span class="facets-count">{{ filter.true_value.count }}</span>
                              </label>
                            </li>
                          {% endif %}
                          {% if filter.false_value != nil %}
                            <li>
                              <label class="facets-option">
                                <input
                                  type="checkbox"
                                  name="{{ filter.param_name }}"
                                  value="{{ filter.false_value.value }}"
                                  {% if filter.false_value.active %}checked{% endif %}
                                  {% if filter.false_value.count == 0 and filter.false_value.active == false %}disabled{% endif %}
                                >
                                <span>{{ filter.false_value.label | escape }}</span>
                                <span class="facets-count">{{ filter.false_value.count }}</span>
                              </label>
                            </li>
                          {% endif %}
                        </ul>

                      {% when 'list' %}
                        <ul class="facets-list" role="list">
                          {% for filter_value in filter.values %}
                            <li>
                              <label class="facets-option">
                                <input
                                  type="checkbox"
                                  name="{{ filter_value.param_name }}"
                                  value="{{ filter_value.value }}"
                                  {% if filter_value.active %}checked{% endif %}
                                  {% if filter_value.count == 0 and filter_value.active == false %}disabled{% endif %}
                                >
                                {% if filter.presentation == 'image' and filter_value.image != blank %}
                                  <span class="facets-image" aria-hidden="true">
                                    {{ filter_value.image
                                      | image_url: width: 80, height: 80, crop: 'center'
                                      | image_tag: loading: 'lazy', widths: '40, 80'
                                    }}
                                  </span>
                                {% elsif filter.presentation == 'swatch' %}
                                  <span
                                    class="facets-swatch"
                                    style="--swatch-color: {{ filter_value.swatch.color | default: 'transparent' }};"
                                    aria-hidden="true"
                                  >
                                    {% if filter_value.swatch.image %}
                                      {{ filter_value.swatch.image
                                        | image_url: width: 40, height: 40, crop: 'center'
                                        | image_tag: loading: 'lazy', widths: '20, 40'
                                      }}
                                    {% endif %}
                                  </span>
                                {% endif %}
                                <span>{{ filter_value.label | escape }}</span>
                                <span class="facets-count">{{ filter_value.count }}</span>
                              </label>
                            </li>
                          {% endfor %}
                        </ul>

                      {% when 'price_range' %}
                        <div class="facets-price-range">
                          <label>
                            <span>{{ price_from_label }}</span>
                            <span class="facets-price-input">
                              <span aria-hidden="true">{{ cart.currency.symbol }}</span>
                              <input
                                class="input"
                                type="text"
                                inputmode="decimal"
                                name="{{ filter.min_value.param_name }}"
                                value="{% if filter.min_value.value %}{{ filter.min_value.value | money_without_currency }}{% endif %}"
                                placeholder="0"
                              >
                            </span>
                          </label>

                          <label>
                            <span>{{ price_to_label }}</span>
                            <span class="facets-price-input">
                              <span aria-hidden="true">{{ cart.currency.symbol }}</span>
                              <input
                                class="input"
                                type="text"
                                inputmode="decimal"
                                name="{{ filter.max_value.param_name }}"
                                value="{% if filter.max_value.value %}{{ filter.max_value.value | money_without_currency }}{% endif %}"
                                placeholder="{{ filter.range_max | money_without_currency }}"
                              >
                            </span>
                          </label>
                        </div>
                    {% endcase %}
                  </div>
                </details>
              </theme-collapse>
            {% endfor %}
          </div>
        </div>

        <div class="dialog-footer facets-actions">
          <button class="btn btn-accent-solid" type="submit">
            {{ show_results_label }}
          </button>

          {% if active_filter_count > 0 %}
            <a
              class="btn btn-sm btn-text-outline"
              href="{{ clear_url }}"
              data-facets-clear
            >
              {{ clear_filters_label }}
            </a>
          {% endif %}
        </div>
      </form>
    </facet-filters>
  </dialog>
</theme-dialog>
