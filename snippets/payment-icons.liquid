{% liquid
  assign icon_size = icon_size | default: 18
  assign wrapper_class = wrapper_class | default: 'payment-icons-wrapper'
%}

{% if shop.enabled_payment_types != empty %}
  <div
    class="payment-icons-wrapper {{ wrapper_class | escape }}"
    style="--payment-icon-height: {{ icon_size }}px;"
  >
    <ul
      class="payment-icons"
      role="list"
      aria-label="{{ 'payment.methods' | t }}"
    >
      {% for payment_type in shop.enabled_payment_types %}
        <li>{{ payment_type | payment_type_svg_tag }}</li>
      {% endfor %}
    </ul>

    <p class="payment-icons-message fs-xs">
      {{ 'payment.secure_options' | t }}
    </p>
  </div>
{% endif %}
