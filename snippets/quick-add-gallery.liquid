{% doc %}
Renders the product media gallery used by the Quick add modal.
{% enddoc %}

{% liquid
  assign image_ratio = settings.quick_add_image_ratio | default: 'adapt'
  assign gallery_media = product.media
  assign gallery_models = gallery_media | where: 'media_type', 'model'
  assign gallery_count = gallery_media.size
  assign selected_variant = product.selected_or_first_available_variant
  assign initial_media = selected_variant.featured_media | default: product.featured_media
  assign initial_preview_image = initial_media.preview_image
  assign initial_media_id = initial_media.id
  assign initial_index = 0
  assign gallery_aspect_ratio = '1 / 1'
  assign gallery_stage_class = 'quick-add-gallery-stage'

  for media in gallery_media
    if media.id == initial_media_id
      assign initial_index = forloop.index0
      break
    endif
  endfor

  if image_ratio == 'adapt'
    if initial_preview_image != blank
      assign gallery_aspect_ratio = initial_preview_image.width | append: ' / ' | append: initial_preview_image.height
    endif
  else
    assign gallery_stage_class = gallery_stage_class | append: ' aspect-ratio-' | append: image_ratio
  endif
%}

<quick-add-gallery
  class="quick-add-media quick-add-gallery"
  data-image-ratio="{{ image_ratio }}"
  style="--quick-add-gallery-aspect-ratio: {{ gallery_aspect_ratio }};"
>
  <div
    class="{{ gallery_stage_class }}"
    role="region"
    aria-label="{{ 'accessibility.product_gallery' | t }}"
    {% if gallery_count > 1 %}tabindex="0"{% endif %}
    data-quick-add-gallery-stage
  >
    <ul
      class="quick-add-gallery-track"
      role="list"
      data-quick-add-gallery-track
      style="transform: translateX(-{{ initial_index | times: 100 }}%);"
    >
      {% for media in gallery_media %}
        {% liquid
          assign image_alt = media.alt | default: product.title
          assign image_loading = 'lazy'
          assign image_fetchpriority = 'auto'

          if forloop.index0 == initial_index
            assign image_loading = 'eager'
            assign image_fetchpriority = 'high'
          endif
        %}
        <li
          class="quick-add-gallery-slide{% if forloop.index0 == initial_index %} is-active{% endif %}"
          data-quick-add-gallery-slide
          data-media-id="{{ media.id }}"
          data-media-type="{{ media.media_type }}"
          aria-hidden="{% if forloop.index0 == initial_index %}false{% else %}true{% endif %}"
          {% unless forloop.index0 == initial_index %}inert{% endunless %}
        >
          {% if media.media_type == 'image' %}
            {{
              media
              | image_url: width: 1200
              | image_tag:
                alt: image_alt,
                class: 'quick-add-gallery-image',
                widths: '320, 480, 640, 800, 1000, 1200',
                sizes: '(min-width: 1200px) 600px, (min-width: 700px) 50vw, 100vw',
                loading: image_loading,
                fetchpriority: image_fetchpriority
            }}
          {% else %}
            {% render 'product-media',
              media: media,
              product: product,
              autoplay: false,
              show_controls: true,
              media_width: 600,
              sizes: '(min-width: 1200px) 600px, (min-width: 700px) 50vw, 100vw',
              loading: image_loading
            %}
          {% endif %}
        </li>
      {% else %}
        <li class="quick-add-gallery-slide is-active" data-quick-add-gallery-slide aria-hidden="false">
          {{ 'image' | placeholder_svg_tag: 'quick-add-gallery-image placeholder-svg' }}
        </li>
      {% endfor %}
    </ul>

    {% if gallery_count > 1 %}
      <div class="quick-add-gallery-controls">
        <button
          class="icon-button"
          type="button"
          aria-label="{{ 'accessibility.previous_media' | t }}"
          data-quick-add-gallery-previous
        >
          {% render 'svg-icons', icon: 'chevron-left', icon_size: 20 %}
        </button>
        <button
          class="icon-button"
          type="button"
          aria-label="{{ 'accessibility.next_media' | t }}"
          data-quick-add-gallery-next
        >
          {% render 'svg-icons', icon: 'chevron-right', icon_size: 20 %}
        </button>
      </div>

      <span class="quick-add-gallery-counter" aria-hidden="true" data-quick-add-gallery-counter>
        {{ initial_index | plus: 1 }} / {{ gallery_count }}
      </span>
    {% endif %}
  </div>

  <span
    class="visually-hidden"
    aria-live="polite"
    data-quick-add-gallery-status
    data-template="{{ 'accessibility.media_status' | t: index: '[index]', count: '[count]' | escape }}"
  ></span>
  {% if gallery_models.size > 0 %}
    <script type="application/json" data-product-models>{{ gallery_models | json }}</script>
  {% endif %}
</quick-add-gallery>
