{% doc %}
Renders the shared language selector dialog with a Shopify localization form.
Rendered once by the theme layout; header, footer and mobile navigation share this dialog.
{% enddoc %}

{% if localization.available_languages.size > 1 %}
  <theme-dialog>
    <dialog
      id="languages-dialog"
      class="dialog modal localization-dialog"
      aria-labelledby="languages-dialog-title"
    >
      <div class="dialog-header">
        <h2 id="languages-dialog-title" class="dialog-title">
          {{ 'general.localization.choose_language' | t }}
        </h2>

        <button
          class="icon-button dialog-close"
          type="button"
          data-dialog-close
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {% render 'svg-icons', icon: 'close' %}
        </button>
      </div>

      <div class="dialog-body">
        {% form 'localization', id: 'LocalizationLanguageForm', class: 'localization-form' %}
          <ul class="localization-list" aria-label="{{ 'general.localization.languages' | t }}">
            {% for language in localization.available_languages %}
              <li>
                <button
                  class="localization-option{% if language.iso_code == localization.language.iso_code %} active{% endif %}"
                  type="submit"
                  name="language_code"
                  value="{{ language.iso_code }}"
                  {% if language.iso_code == localization.language.iso_code %}aria-current="true"{% endif %}
                >
                  <span class="localization-option-text">
                    <span>{{ language.endonym_name | capitalize }}</span>
                    <small>{{ language.name }} ({{ language.iso_code }})</small>
                  </span>
                </button>
              </li>
            {% endfor %}
          </ul>
        {% endform %}
      </div>
    </dialog>
  </theme-dialog>
{% endif %}
