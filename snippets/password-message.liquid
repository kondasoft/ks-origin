{% doc %}
Renders the visitor message shared by the password message block and the section fallback.

@param {string} text_size - Text size utility class.
@param {number} pt - Top spacing in pixels.
@param {number} pb - Bottom spacing in pixels.
@param {string} [shopify_attributes] - Theme editor attributes for a message block.
{% enddoc %}

{% if shop.password_message != blank %}
  <div
    class="password-message block-spacing"
    style="
      --pt: {{ pt | divided_by: 16.0 | append: 'em' }};
      --pb: {{ pb | divided_by: 16.0 | append: 'em' }};
    "
    {{ shopify_attributes }}
  >
    <div class="rte {{ text_size }}">
      {{ shop.password_message }}
    </div>
  </div>
{% endif %}
