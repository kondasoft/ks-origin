{% liquid
  assign shop_name = shop.name | escape | split: '(' | first | strip
%}

<div
  class="password-footer"
  style="
    --color-background: {{ section.settings.background_color.red }} {{ section.settings.background_color.green }} {{ section.settings.background_color.blue }};
    --color-text: {{ section.settings.text_color.red }} {{ section.settings.text_color.green }} {{ section.settings.text_color.blue }};
    --color-accent: {{ section.settings.accent_color.red }} {{ section.settings.accent_color.green }} {{ section.settings.accent_color.blue }};
    --pt: {{ section.settings.pt | divided_by: 16.0 | append: 'em' }};
    --pb: {{ section.settings.pb | divided_by: 16.0 | append: 'em' }};
  "
>
  <div class="password-footer-inner container {{ settings.container_width }}">
    <p class="password-footer-copyright">
      &copy; {{ 'now' | date: '%Y' }}
      <a href="{{ routes.root_url }}">{{ shop_name }}</a>.
      {{ 'general.footer.all_rights_reserved' | t }}
    </p>

    <div class="password-footer-links">
      <button
        class="password-footer-password-button"
        type="button"
        data-toggle="password-dialog"
      >
        {{ 'general.password.enter_using_password' | t }}
      </button>

      <p class="password-footer-owner">
        {{ 'general.password.store_owner' | t }}
        <a href="/admin">{{ 'general.password.log_in' | t }}</a>
      </p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Password footer",
  "tag": "footer",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "{{ settings.colors.surface }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "{{ settings.colors.text }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "{{ settings.colors.accent }}"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 24
    }
  ]
}
{% endschema %}
