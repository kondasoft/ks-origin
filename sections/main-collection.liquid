{% liquid
  assign collection_image_class = 'main-collection-image'
  assign collection_image_sizes = '(min-width: 1200px) 50vw, 100vw'

  unless section.settings.image_ratio == 'adapt'
    assign collection_image_class = collection_image_class | append: ' aspect-ratio aspect-ratio-' | append: section.settings.image_ratio
  endunless

  if section.settings.desktop_image_width == 'one-third'
    assign collection_image_sizes = '(min-width: 1200px) 33vw, 100vw'
  endif

  assign prouducts_per_page = section.settings.products_per_page | default: 24

  if shop.permanent_domain contains 'ks-'
    assign prouducts_per_page = 12
  endif

  assign pagination_previous = 'general.pagination.previous' | t
  assign pagination_next = 'general.pagination.next' | t
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign show_collection_filters = false
  assign active_filter_count = 0

  if section.settings.show_filters and collection.filters.size > 0
    assign show_collection_filters = true
  endif

  for filter in collection.filters
    case filter.type
      when 'boolean'
        if filter.true_value != nil and filter.true_value.active
          assign active_filter_count = active_filter_count | plus: 1
        endif
        if filter.false_value != nil and filter.false_value.active
          assign active_filter_count = active_filter_count | plus: 1
        endif
      when 'list'
        assign active_filter_count = active_filter_count | plus: filter.active_values.size
      when 'price_range'
        if filter.min_value.value != nil or filter.max_value.value != nil
          assign active_filter_count = active_filter_count | plus: 1
        endif
    endcase
  endfor

  assign encoded_sort_by = sort_by | url_encode
  assign filters_clear_url = collection.url | append: '?sort_by=' | append: encoded_sort_by
%}

<collection-view
  class="main-collection responsive-text-alignment section-spacing"
  data-section-id="{{ section.id }}"
  data-mobile-text-alignment="{{ section.settings.mobile_text_alignment }}"
  data-desktop-text-alignment="{{ section.settings.desktop_text_alignment }}"
  data-has-image="{% if section.settings.show_image and collection.image != blank %}true{% else %}false{% endif %}"
  style="
    --color-background: {{ section.settings.background_color.red }} {{ section.settings.background_color.green }} {{ section.settings.background_color.blue }};
    --color-text: {{ section.settings.text_color.red }} {{ section.settings.text_color.green }} {{ section.settings.text_color.blue }};
    --color-accent: {{ section.settings.accent_color.red }} {{ section.settings.accent_color.green }} {{ section.settings.accent_color.blue }};
    --mobile-text-alignment: {{ section.settings.mobile_text_alignment }};
    --desktop-text-alignment: {{ section.settings.desktop_text_alignment }};
    --mobile-columns: {{ section.settings.mobile_columns }};
    --tablet-columns: 2;
    --desktop-columns: {{ section.settings.desktop_columns }};
    --pt: {{ section.settings.pt | divided_by: 16.0 | append: 'em' }};
    --pb: {{ section.settings.pb | divided_by: 16.0 | append: 'em' }};
  "
>
  <p class="visually-hidden" role="status" aria-live="polite" data-collection-status></p>

  <div class="container {{ settings.container_width }}">
    <header
      class="main-collection-header{% if section.settings.show_image and collection.image != blank %} main-collection-header-with-image{% endif %}"
      data-desktop-image-width="{{ section.settings.desktop_image_width }}"
    >
      {% if section.settings.show_image and collection.image != blank %}
        {{ collection.image
          | image_url: width: 2400
          | image_tag:
            class: collection_image_class,
            widths: '320, 640, 960, 1280, 1600, 2000, 2400',
            sizes: collection_image_sizes,
            loading: 'eager',
            fetchpriority: 'high'
        }}
      {% endif %}

      <div class="main-collection-header-content">
        {% if section.settings.show_breadcrumbs %}
          {% render 'breadcrumb', current_title: collection.title %}
        {% endif %}

        <h1 class="main-collection-title {{ section.settings.heading_size }}">
          {{ collection.title | escape }}
        </h1>

        {% if section.settings.show_description and collection.description != blank %}
          <div class="main-collection-description rte {{ section.settings.description_size }}">
            {{ collection.description }}
          </div>
        {% endif %}
      </div>
    </header>

    <div
      class="main-collection-product-grid"
      data-collection-product-grid
      data-product-count-text="{{ 'collections.products_count' | t: count: collection.products_count | escape }}"
      tabindex="-1"
    >
      {% if section.settings.show_product_count or show_collection_filters or section.settings.show_sort %}
        <div class="collection-utilities">
          {% if section.settings.show_product_count %}
            <p class="collection-products-count">
              {{ 'collections.products_count' | t: count: collection.products_count }}
            </p>
          {% endif %}

          {% if show_collection_filters or section.settings.show_sort %}
            <div class="btn-group">
              {% if show_collection_filters %}
                <button
                  class="btn btn-sm btn-text-outline"
                  type="button"
                  data-toggle="collection-filters-dialog"
                >
                  {% render 'svg-icons', icon: 'filter', icon_size: 16 %}
                  {{ 'collections.filters' | t }}
                  {% if active_filter_count > 0 %}
                    <span aria-hidden="true">({{ active_filter_count }})</span>
                    <span class="visually-hidden">
                      {{ 'collections.active_filters_count' | t: count: active_filter_count }}
                    </span>
                  {% endif %}
                </button>
              {% endif %}

              {% if section.settings.show_sort %}
                <theme-dropdown class="theme-dropdown">
                  <button
                    class="theme-dropdown-btn btn btn-sm btn-text-outline"
                    type="button"
                    aria-expanded="false"
                  >
                    {% render 'svg-icons', icon: 'sliders', icon_size: 16 %}
                    {{ 'collections.sort' | t }}
                    {% render 'svg-icons', icon: 'chevron-down', icon_size: 14 %}
                  </button>

                  <div
                    class="theme-dropdown-content"
                    data-dropdown-alignment="right"
                    hidden
                  >
                    <collection-sort>
                      <form
                        class="collection-sort-form"
                        action="{{ collection.url }}"
                        method="get"
                        aria-label="{{ 'collections.sort' | t }}"
                      >
                        {% for filter in collection.filters %}
                          {% case filter.type %}
                            {% when 'boolean' %}
                              {% if filter.true_value != nil and filter.true_value.active %}
                                <input type="hidden" name="{{ filter.param_name }}" value="{{ filter.true_value.value }}">
                              {% endif %}
                              {% if filter.false_value != nil and filter.false_value.active %}
                                <input type="hidden" name="{{ filter.param_name }}" value="{{ filter.false_value.value }}">
                              {% endif %}
                            {% when 'list' %}
                              {% for filter_value in filter.active_values %}
                                <input type="hidden" name="{{ filter_value.param_name }}" value="{{ filter_value.value }}">
                              {% endfor %}
                            {% when 'price_range' %}
                              {% if filter.min_value.value %}
                                <input
                                  type="hidden"
                                  name="{{ filter.min_value.param_name }}"
                                  value="{{ filter.min_value.value | money_without_currency }}"
                                >
                              {% endif %}
                              {% if filter.max_value.value %}
                                <input
                                  type="hidden"
                                  name="{{ filter.max_value.param_name }}"
                                  value="{{ filter.max_value.value | money_without_currency }}"
                                >
                              {% endif %}
                          {% endcase %}
                        {% endfor %}

                        <ul class="collection-sort-list" role="list">
                          {% for option in collection.sort_options %}
                            <li>
                              <label class="collection-sort-option">
                                <input
                                  class="visually-hidden"
                                  type="radio"
                                  name="sort_by"
                                  value="{{ option.value }}"
                                  {% if option.value == sort_by %}checked{% endif %}
                                >
                                <span>{{ option.name }}</span>
                              </label>
                            </li>
                          {% endfor %}
                        </ul>

                        <noscript>
                          <button class="btn btn-sm btn-text-outline" type="submit">
                            {{ 'general.apply' | t }}
                          </button>
                        </noscript>
                      </form>
                    </collection-sort>
                  </div>
                </theme-dropdown>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% paginate collection.products by prouducts_per_page %}
        {% if collection.products.size > 0 %}
          <ul class="product-grid" role="list">
            {% for product in collection.products %}
              <li class="product-grid-item">
                {% content_for 'block', type: 'product-card', id: 'product-card', closest.product: product %}
              </li>
            {% endfor %}
          </ul>

          {% if paginate.pages > 1 %}
            <nav class="pagination" aria-label="{{ 'accessibility.pagination' | t }}">
              {{ paginate
                | default_pagination:
                  previous: pagination_previous,
                  next: pagination_next
              }}
            </nav>
          {% endif %}
        {% else %}
          <p class="product-grid-empty">
            {{ 'collections.empty' | t }}
          </p>
        {% endif %}
      {% endpaginate %}
    </div>
  </div>

  {% if show_collection_filters %}
    <theme-dialog>
      <dialog
        id="collection-filters-dialog"
        class="dialog drawer drawer-right collection-filters-dialog"
        aria-labelledby="collection-filters-dialog-title"
      >
      <div class="dialog-header">
        <h2 id="collection-filters-dialog-title" class="dialog-title">
          {{ 'collections.filters' | t }}
        </h2>

        <button
          class="icon-button dialog-close"
          type="button"
          data-dialog-close
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {% render 'svg-icons', icon: 'close' %}
        </button>
      </div>

      <collection-filters class="collection-filters">
        <form
          class="collection-filters-form"
          action="{{ collection.url }}"
          method="get"
          data-collection-filters-form
        >
          <input type="hidden" name="sort_by" value="{{ sort_by }}">

          <div class="dialog-body">
            <div class="collection-filter-groups">
              {% for filter in collection.filters %}
                  {% liquid
                    assign filter_active_count = 0

                    case filter.type
                      when 'boolean'
                        if filter.true_value != nil and filter.true_value.active
                          assign filter_active_count = filter_active_count | plus: 1
                        endif
                        if filter.false_value != nil and filter.false_value.active
                          assign filter_active_count = filter_active_count | plus: 1
                        endif
                      when 'list'
                        assign filter_active_count = filter.active_values.size
                      when 'price_range'
                        if filter.min_value.value != nil or filter.max_value.value != nil
                          assign filter_active_count = 1
                        endif
                    endcase
                  %}

                  <theme-collapse class="theme-collapse collection-filter">
                    <details class="theme-collapse-details" open>
                      <summary class="theme-collapse-summary">
                        <span>
                          {{ filter.label | escape }}
                          {% if filter_active_count > 0 %}
                            ({{ filter_active_count }})
                          {% endif %}
                        </span>
                        <span class="theme-collapse-icon" aria-hidden="true">
                          {% render 'svg-icons', icon: 'chevron-down', icon_size: 18 %}
                        </span>
                      </summary>

                      <div class="theme-collapse-content">
                        {% case filter.type %}
                          {% when 'boolean' %}
                            <ul class="collection-filter-list" role="list">
                              {% if filter.true_value != nil %}
                                <li>
                                  <label class="collection-filter-option">
                                    <input
                                      type="checkbox"
                                      name="{{ filter.param_name }}"
                                      value="{{ filter.true_value.value }}"
                                      {% if filter.true_value.active %}checked{% endif %}
                                      {% if filter.true_value.count == 0 and filter.true_value.active == false %}disabled{% endif %}
                                    >
                                    <span>{{ filter.true_value.label | escape }}</span>
                                    <span class="collection-filter-count">{{ filter.true_value.count }}</span>
                                  </label>
                                </li>
                              {% endif %}
                              {% if filter.false_value != nil %}
                                <li>
                                  <label class="collection-filter-option">
                                    <input
                                      type="checkbox"
                                      name="{{ filter.param_name }}"
                                      value="{{ filter.false_value.value }}"
                                      {% if filter.false_value.active %}checked{% endif %}
                                      {% if filter.false_value.count == 0 and filter.false_value.active == false %}disabled{% endif %}
                                    >
                                    <span>{{ filter.false_value.label | escape }}</span>
                                    <span class="collection-filter-count">{{ filter.false_value.count }}</span>
                                  </label>
                                </li>
                              {% endif %}
                            </ul>

                          {% when 'list' %}
                            <ul class="collection-filter-list" role="list">
                              {% for filter_value in filter.values %}
                                <li>
                                  <label class="collection-filter-option">
                                    <input
                                      type="checkbox"
                                      name="{{ filter_value.param_name }}"
                                      value="{{ filter_value.value }}"
                                      {% if filter_value.active %}checked{% endif %}
                                      {% if filter_value.count == 0 and filter_value.active == false %}disabled{% endif %}
                                    >
                                    {% if filter.presentation == 'image' and filter_value.image != blank %}
                                      <span class="collection-filter-image" aria-hidden="true">
                                        {{ filter_value.image
                                          | image_url: width: 80, height: 80, crop: 'center'
                                          | image_tag: loading: 'lazy', widths: '40, 80'
                                        }}
                                      </span>
                                    {% elsif filter.presentation == 'swatch' %}
                                      <span
                                        class="collection-filter-swatch"
                                        style="--swatch-color: {{ filter_value.swatch.color | default: 'transparent' }};"
                                        aria-hidden="true"
                                      >
                                        {% if filter_value.swatch.image %}
                                          {{ filter_value.swatch.image
                                            | image_url: width: 40, height: 40, crop: 'center'
                                            | image_tag: loading: 'lazy', widths: '20, 40'
                                          }}
                                        {% endif %}
                                      </span>
                                    {% endif %}
                                    <span>{{ filter_value.label | escape }}</span>
                                    <span class="collection-filter-count">{{ filter_value.count }}</span>
                                  </label>
                                </li>
                              {% endfor %}
                            </ul>

                          {% when 'price_range' %}
                            <div class="collection-filter-price-range">
                              <label>
                                <span>{{ 'collections.price_from' | t }}</span>
                                <span class="collection-filter-price-input">
                                  <span aria-hidden="true">{{ cart.currency.symbol }}</span>
                                  <input
                                    class="input"
                                    type="text"
                                    inputmode="decimal"
                                    name="{{ filter.min_value.param_name }}"
                                    value="{% if filter.min_value.value %}{{ filter.min_value.value | money_without_currency }}{% endif %}"
                                    placeholder="0"
                                  >
                                </span>
                              </label>

                              <label>
                                <span>{{ 'collections.price_to' | t }}</span>
                                <span class="collection-filter-price-input">
                                  <span aria-hidden="true">{{ cart.currency.symbol }}</span>
                                  <input
                                    class="input"
                                    type="text"
                                    inputmode="decimal"
                                    name="{{ filter.max_value.param_name }}"
                                    value="{% if filter.max_value.value %}{{ filter.max_value.value | money_without_currency }}{% endif %}"
                                    placeholder="{{ filter.range_max | money_without_currency }}"
                                  >
                                </span>
                              </label>
                            </div>
                        {% endcase %}
                      </div>
                    </details>
                  </theme-collapse>
              {% endfor %}
            </div>
          </div>

          <div class="dialog-footer collection-filter-actions">
            <button class="btn btn-accent-solid" type="submit">
              {{ 'collections.show_products' | t: count: collection.products_count }}
            </button>

            {% if active_filter_count > 0 %}
              <a
                class="btn btn-sm btn-text-outline"
                href="{{ filters_clear_url }}"
                data-collection-filter-clear
              >
                {{ 'collections.clear_filters' | t }}
              </a>
            {% endif %}
          </div>
        </form>
      </collection-filters>
      </dialog>
    </theme-dialog>
  {% endif %}
</collection-view>

{% schema %}
{
  "name": "Collection",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "{{ settings.colors.background }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "{{ settings.colors.text }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "{{ settings.colors.accent }}"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show collection image",
      "default": true,
      "info": "Uses the image assigned to this collection."
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "group": "Adapt", "value": "adapt", "label": "Adapt to image" },
        { "group": "Square", "value": "square", "label": "Square (1:1)" },
        { "group": "Horizontal", "value": "landscape", "label": "Landscape (4:3)" },
        { "group": "Horizontal", "value": "widescreen", "label": "Widescreen (16:9)" }
      ],
      "default": "widescreen",
      "visible_if": "{{ section.settings.show_image == true }}"
    },
    {
      "type": "select",
      "id": "desktop_image_width",
      "label": "Desktop image width",
      "options": [
        { "value": "half", "label": "Half (1/2)" },
        { "value": "one-third", "label": "One third (1/3)" }
      ],
      "default": "half",
      "visible_if": "{{ section.settings.show_image == true }}"
    },
    {
      "type": "text_alignment",
      "id": "mobile_text_alignment",
      "label": "Mobile text alignment",
      "default": "left"
    },
    {
      "type": "text_alignment",
      "id": "desktop_text_alignment",
      "label": "Desktop text alignment",
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h1",
      "info": "Changes the visual size only. The HTML heading remains H1."
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "select",
      "id": "description_size",
      "label": "Description size",
      "options": [
        { "value": "fs-xs", "label": "Extra small" },
        { "value": "fs-sm", "label": "Small" },
        { "value": "fs-md", "label": "Medium" },
        { "value": "fs-lg", "label": "Large" },
        { "value": "fs-xl", "label": "Extra large" }
      ],
      "default": "fs-md",
      "visible_if": "{{ section.settings.show_description == true }}"
    },
    {
      "type": "header",
      "content": "Collection utilities"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show filters",
      "info": "Manage available filters with Shopify's [Search & Discovery app](https://apps.shopify.com/search-and-discovery).",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show sort",
      "default": true
    },
    {
      "type": "header",
      "content": "Product grid"
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "info": "Tablet layouts always use two columns.",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 60
    }
  ],
  "enabled_on": {
    "templates": ["collection"]
  },
  "presets": [
    {
      "name": "Collection",
      "category": "Collection",
      "blocks": [
        {
          "type": "product-card",
          "id": "product-card",
          "static": true,
          "settings": {
            "text_alignment": "left"
          },
          "blocks": [
            {
              "type": "product-card-image",
              "settings": {
                "image_ratio": "square"
              }
            },
            {
              "type": "product-card-title",
              "settings": {
                "font_family": "heading",
                "heading_size": "fs-md"
              }
            },
            {
              "type": "product-rating",
              "settings": {
                "show_count": true,
                "rating_size": "fs-sm"
              }
            },
            {
              "type": "product-card-price",
              "settings": {
                "price_size": "fs-md"
              }
            },
            {
              "type": "product-card-form",
              "settings": {
                "button_style": "btn-accent-solid",
                "button_size": "btn-sm"
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
