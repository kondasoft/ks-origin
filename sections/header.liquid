<div
  class="header header-decoration-{{ section.settings.bottom_decoration }} section-spacing"
  style="
    --background-color: {{ section.settings.background_color.red }} {{ section.settings.background_color.green }} {{ section.settings.background_color.blue }};
    --text-color: {{ section.settings.text_color.red }} {{ section.settings.text_color.green }} {{ section.settings.text_color.blue }};
    --pt: {{ section.settings.pt | append: 'px' }};
    --pb: {{ section.settings.pb | append: 'px' }};
  "
>
  <div class="container {{ settings.container_width }}">
  <div class="header-inner header-inner-mobile">
    <div class="header-icons header-icons-left">
      <button
        class="header-icon-link header-menu-button"
        type="button"
        data-toggle="mobile-menu-dialog"
        aria-controls="mobile-menu-dialog"
        aria-expanded="false"
        aria-haspopup="dialog"
        aria-label="{{ 'accessibility.menu' | t }}"
      >
        {% render 'svg-icons', icon: 'menu' %}
      </button>

      <a
        class="header-icon-link"
        href="{{ routes.search_url }}"
        data-toggle="search-dialog"
        aria-controls="search-dialog"
        aria-expanded="false"
        aria-haspopup="dialog"
        aria-label="{{ 'accessibility.search' | t }}"
      >
        {% render 'svg-icons', icon: 'search' %}
      </a>
    </div>

    <a
      class="header-logo"
      href="{{ routes.root_url }}"
      aria-label="{{ shop.name | escape }}"
    >
      {% if section.settings.logo != blank %}
        {{ section.settings.logo
          | image_url: width: 352
          | image_tag:
            class: 'header-logo-image',
            widths: '176, 352',
            width: 176,
            height: 32,
            loading: 'eager',
            fetchpriority: 'high',
            alt: shop.name
        }}
      {% else %}
        <span class="header-logo-text">{{ shop.name }}</span>
      {% endif %}
    </a>

    <div class="header-icons header-icons-right">
      <a
        class="header-icon-link"
        href="{{ routes.account_url }}"
        aria-label="{{ 'accessibility.account' | t }}"
      >
        {% render 'svg-icons', icon: 'account' %}
      </a>

      <a
        class="header-icon-link header-cart-link"
        href="{{ routes.cart_url }}"
        data-toggle="cart-dialog"
        aria-controls="cart-dialog"
        aria-expanded="false"
        aria-haspopup="dialog"
        aria-label="{{ 'accessibility.cart' | t }}"
      >
        {% render 'svg-icons', icon: 'bag' %}
        <span class="cart-count-badge" data-cart-badge data-item-count="{{ cart.item_count }}">
          {{ cart.item_count }}
        </span>
      </a>
    </div>
  </div>

  <div class="header-inner header-inner-desktop">
    <a class="header-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo
          | image_url: width: 352
          | image_tag:
            class: 'header-logo-image',
            widths: '176, 352',
            width: 176,
            height: 32,
            loading: 'eager',
            fetchpriority: 'high',
            alt: shop.name
        }}
      {% else %}
        <span class="header-logo-text">{{ shop.name }}</span>
      {% endif %}
    </a>

    {% if section.settings.menu.links.size > 0 %}
      <nav class="header-nav" aria-label="{{ 'accessibility.navigation' | t }}">
        {% for link in section.settings.menu.links %}
          <a
            class="header-nav-link{% if link.active %} active{% endif %}"
            href="{{ link.url }}"
            {% if link.current %}aria-current="page"{% endif %}
          >
            {{ link.title }}
          </a>
        {% endfor %}
      </nav>
    {% endif %}

    <div class="header-icons">
      <a
        class="header-icon-link"
        href="{{ routes.search_url }}"
        data-toggle="search-dialog"
        aria-controls="search-dialog"
        aria-expanded="false"
        aria-haspopup="dialog"
        aria-label="{{ 'accessibility.search' | t }}"
      >
        {% render 'svg-icons', icon: 'search' %}
      </a>

      <a
        class="header-icon-link"
        href="{{ routes.account_url }}"
        aria-label="{{ 'accessibility.account' | t }}"
      >
        {% render 'svg-icons', icon: 'account' %}
      </a>

      <a
        class="header-icon-link header-cart-link"
        href="{{ routes.cart_url }}"
        data-toggle="cart-dialog"
        aria-controls="cart-dialog"
        aria-expanded="false"
        aria-haspopup="dialog"
        aria-label="{{ 'accessibility.cart' | t }}"
      >
        {% render 'svg-icons', icon: 'bag' %}
        <span class="cart-count-badge" data-cart-badge data-item-count="{{ cart.item_count }}">
          {{ cart.item_count }}
        </span>
      </a>
    </div>
  </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "tag": "header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "{{ settings.colors.background }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "{{ settings.colors.text }}"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "bottom_decoration",
      "label": "Bottom decoration",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "border-bottom", "label": "Border bottom" },
        { "value": "box-shadow", "label": "Box shadow" }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [],
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "Header",
      "category": "Header"
    }
  ]
}
{% endschema %}
