<div
  class="main-product section-spacing"
  style="
    --color-background: {{ section.settings.background_color.red }} {{ section.settings.background_color.green }} {{ section.settings.background_color.blue }};
    --color-text: {{ section.settings.text_color.red }} {{ section.settings.text_color.green }} {{ section.settings.text_color.blue }};
    --color-accent: {{ section.settings.accent_color.red }} {{ section.settings.accent_color.green }} {{ section.settings.accent_color.blue }};
    --pt: {{ section.settings.pt | divided_by: 16.0 | append: 'em' }};
    --pb: {{ section.settings.pb | divided_by: 16.0 | append: 'em' }};
  "
>
  <div class="container {{ settings.container_width }}">
    <div class="main-product-layout">
      <div class="main-product-media">
        {% render 'product-gallery' %}
      </div>

      <div class="main-product-details">
        {% content_for 'blocks', closest.product: product %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "{{ settings.colors.background }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "{{ settings.colors.text }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "{{ settings.colors.accent }}"
    },
    {
      "type": "header",
      "content": "Gallery"
    },
    {
      "type": "select",
      "id": "gallery_transition",
      "label": "Transition",
      "options": [
        { "value": "slide", "label": "Slide" },
        { "value": "fade", "label": "Fade" }
      ],
      "default": "slide"
    },
    {
      "type": "checkbox",
      "id": "gallery_show_navigation",
      "label": "Show navigation buttons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "gallery_show_counter",
      "label": "Show image counter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "gallery_show_thumbnails",
      "label": "Show thumbnails",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "_product-main-vendor"
    },
    {
      "type": "_product-main-title"
    },
    {
      "type": "_product-main-price"
    },
    {
      "type": "_product-main-sku"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "Product",
      "category": "Product",
      "blocks": [
        {
          "type": "_product-main-vendor",
          "settings": {
            "text_size": "fs-sm",
            "pt": 0,
            "pb": 6
          }
        },
        {
          "type": "_product-main-title",
          "settings": {
            "heading_size": "h1",
            "pt": 0,
            "pb": 6
          }
        },
        {
          "type": "_product-main-price",
          "settings": {
            "price_size": "fs-xl",
            "pt": 0,
            "pb": 0
          }
        },
        {
          "type": "_product-main-sku",
          "settings": {
            "text_size": "fs-sm",
            "pt": 0,
            "pb": 0
          }
        }
      ]
    }
  ]
}
{% endschema %}
