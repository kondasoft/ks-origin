{% liquid
  assign search_types = ''

  if section.settings.search_products
    assign search_types = 'product'
  endif

  if section.settings.search_articles
    if search_types != blank
      assign search_types = search_types | append: ','
    endif
    assign search_types = search_types | append: 'article'
  endif

  if section.settings.search_pages
    if search_types != blank
      assign search_types = search_types | append: ','
    endif
    assign search_types = search_types | append: 'page'
  endif

  if search_types == blank
    assign search_types = 'product'
  endif

  assign sort_by = search.sort_by | default: search.default_sort_by
  assign active_filter_count = 0

  for filter in search.filters
    case filter.type
      when 'boolean'
        if filter.true_value != nil and filter.true_value.active
          assign active_filter_count = active_filter_count | plus: 1
        endif
        if filter.false_value != nil and filter.false_value.active
          assign active_filter_count = active_filter_count | plus: 1
        endif
      when 'list'
        assign active_filter_count = active_filter_count | plus: filter.active_values.size
      when 'price_range'
        if filter.min_value.value != nil or filter.max_value.value != nil
          assign active_filter_count = active_filter_count | plus: 1
        endif
    endcase
  endfor

  assign encoded_search_terms = search.terms | url_encode
  assign encoded_sort_by = sort_by | url_encode
  assign encoded_search_types = search_types | url_encode
  assign filters_clear_url = routes.search_url | append: '?q=' | append: encoded_search_terms | append: '&type=' | append: encoded_search_types | append: '&options%5Bprefix%5D=last&sort_by=' | append: encoded_sort_by
%}

<faceted-results
  class="main-search"
  data-section-id="{{ section.id }}"
  data-search-query="{{ search.terms | escape }}"
  style="
    --color-background: {{ section.settings.background_color.red }} {{ section.settings.background_color.green }} {{ section.settings.background_color.blue }};
    --color-text: {{ section.settings.text_color.red }} {{ section.settings.text_color.green }} {{ section.settings.text_color.blue }};
    --color-accent: {{ section.settings.accent_color.red }} {{ section.settings.accent_color.green }} {{ section.settings.accent_color.blue }};
  "
>
  <p class="visually-hidden" role="status" aria-live="polite" data-faceted-results-status></p>

  {% content_for 'block', type: '_search-header', id: 'search-header' %}

  <div
    class="faceted-results-grid"
    data-faceted-results-grid
    data-result-count="{{ search.results_count }}"
    data-result-count-text="{{ 'search.results_count' | t: count: search.results_count | escape }}"
    tabindex="-1"
  >
    {% content_for 'block', type: '_search-toolbar', id: 'search-toolbar' %}
    {% content_for 'block', type: '_search-results-grid', id: 'search-results-grid' %}
  </div>

  {% if search.performed and section.settings.search_products and search.filters.size > 0 %}
    {% render 'facets-dialog',
      context: 'search',
      filters: search.filters,
      form_action: routes.search_url,
      sort_by: sort_by,
      clear_url: filters_clear_url,
      active_filter_count: active_filter_count,
      result_count: search.results_count,
      section_id: section.id,
      search_terms: search.terms,
      search_types: search_types
    %}
  {% endif %}
</faceted-results>

{% schema %}
{
  "name": "Search",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "{{ settings.colors.background }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "{{ settings.colors.text }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "{{ settings.colors.accent }}"
    },
    {
      "type": "header",
      "content": "Search sources"
    },
    {
      "type": "paragraph",
      "content": "Select at least one source. Products are used if every source is disabled."
    },
    {
      "type": "checkbox",
      "id": "search_products",
      "label": "Search products",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "search_articles",
      "label": "Search articles",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "search_pages",
      "label": "Search pages",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "_search-header"
    },
    {
      "type": "_search-toolbar"
    },
    {
      "type": "_search-results-grid"
    }
  ],
  "enabled_on": {
    "templates": ["search"]
  },
  "presets": [
    {
      "name": "Search",
      "category": "Search",
      "blocks": [
        {
          "type": "_search-header",
          "id": "search-header",
          "static": true
        },
        {
          "type": "_search-toolbar",
          "id": "search-toolbar",
          "static": true
        },
        {
          "type": "_search-results-grid",
          "id": "search-results-grid",
          "static": true,
          "blocks": [
            {
              "type": "product-card",
              "id": "product-card",
              "static": true,
              "blocks": [
                {
                  "type": "_product-card-image"
                },
                {
                  "type": "_product-card-title"
                },
                {
                  "type": "_product-card-rating"
                },
                {
                  "type": "_product-card-price"
                },
                {
                  "type": "_product-card-swatches"
                },
                {
                  "type": "_product-card-form"
                }
              ]
            },
            {
              "type": "article-card",
              "id": "article-card",
              "static": true,
              "blocks": [
                {
                  "type": "_article-card-image",
                  "settings": {
                    "show_tags": false
                  }
                },
                {
                  "type": "_article-card-heading",
                  "settings": {
                    "heading_size": "fs-md"
                  }
                },
                {
                  "type": "_article-card-meta"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
