{% liquid
  assign container_class = 'liquid-html-content'

  if section.settings.container_width == 'site'
    assign container_class = container_class | append: ' container ' | append: settings.container_width
  elsif section.settings.container_width == 'narrow'
    assign container_class = container_class | append: ' container container-content'
  endif
%}

<div
  class="liquid-html responsive-text-alignment section-spacing"
  data-mobile-text-alignment="{{ section.settings.mobile_text_alignment }}"
  data-desktop-text-alignment="{{ section.settings.desktop_text_alignment }}"
  style="
    --color-background: {{ section.settings.background_color.red }} {{ section.settings.background_color.green }} {{ section.settings.background_color.blue }};
    --color-text: {{ section.settings.text_color.red }} {{ section.settings.text_color.green }} {{ section.settings.text_color.blue }};
    --color-accent: {{ section.settings.accent_color.red }} {{ section.settings.accent_color.green }} {{ section.settings.accent_color.blue }};
    --mobile-text-alignment: {{ section.settings.mobile_text_alignment }};
    --desktop-text-alignment: {{ section.settings.desktop_text_alignment }};
    --pt: {{ section.settings.pt | divided_by: 16.0 | append: 'em' }};
    --pb: {{ section.settings.pb | divided_by: 16.0 | append: 'em' }};
    color: rgb(var(--color-text));
    background-color: rgb(var(--color-background));
  "
>
  <div class="{{ container_class }}">
    {% content_for 'block', type: 'group', id: 'header' %}

    {{ section.settings.custom_liquid }}
  </div>
</div>

{% schema %}
{
  "name": "Liquid / HTML",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Liquid / HTML",
      "default": "<p class=\"alert\">Today's date: {{ 'now' | date: '%B %d, %Y' }}</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "{{ settings.colors.background }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "{{ settings.colors.text }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "{{ settings.colors.accent }}"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "site", "label": "Site container" },
        { "value": "narrow", "label": "Narrow container" }
      ],
      "default": "site"
    },
    {
      "type": "text_alignment",
      "id": "mobile_text_alignment",
      "label": "Mobile text alignment",
      "default": "left"
    },
    {
      "type": "text_alignment",
      "id": "desktop_text_alignment",
      "label": "Desktop text alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "Liquid / HTML",
      "category": "Custom",
      "blocks": [
        {
          "type": "group",
          "id": "header",
          "static": true,
          "name": "Header",
          "settings": {
            "mobile_content_direction": "column",
            "mobile_gap": 0,
            "mobile_alignment": "inherit",
            "desktop_content_direction": "column",
            "desktop_gap": 0,
            "desktop_alignment": "inherit",
            "pt": 0,
            "pb": 28,
            "pl": 0,
            "pr": 0
          },
          "blocks": [
            {
              "type": "heading",
              "settings": {
                "heading": "Liquid / HTML",
                "heading_tag": "2",
                "heading_size": "h2",
                "pt": 0,
                "pb": 0
              }
            },
            {
              "type": "text",
              "settings": {
                "text": "<p>Add custom Liquid or HTML to create flexible storefront content.</p>",
                "text_size": "fs-md",
                "pt": 6,
                "pb": 0
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
