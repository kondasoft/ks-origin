{% if section.index <= 3 or request.design_mode %}
  <link href="{{ 'announcement-bar.css' | asset_url }}" rel="stylesheet" fetchpriority="high">
{% endif %}

<div
  class="announcement-bar"
  style="
    --background-color: {{ section.settings.background_color.red }} {{ section.settings.background_color.green }} {{ section.settings.background_color.blue }};
    --text-color: {{ section.settings.text_color.red }} {{ section.settings.text_color.green }} {{ section.settings.text_color.blue }};
    --fs-mobile: var(--{{ section.settings.font_size_mobile }});
    --fs-desktop: var(--{{ section.settings.font_size_desktop }});
    --pt: {{ section.settings.pt | append: 'px' }};
    --pb: {{ section.settings.pb | append: 'px' }};
  "
  data-section-css="{{ 'announcement-bar.css' | asset_url }}"
>
  <div class="container">
    {% if section.settings.link != blank %}
      <a
        class="announcement-bar-link section-spacing"
        href="{{ section.settings.link }}"
      >
        <p class="announcement-bar-text rte">
          {{ section.settings.text }}
        </p>
      </a>
    {% else %}
      <div class="section-spacing">
        <p class="announcement-bar-text rte">
          {{ section.settings.text }}
        </p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "default": "Announce something important here"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "font_size_mobile",
      "label": "Font size mobile",
      "options": [
        { "value": "fs-xs", "label": "Extra small" },
        { "value": "fs-sm", "label": "Small" },
        { "value": "fs-md", "label": "Medium" },
        { "value": "fs-lg", "label": "Large" },
        { "value": "fs-xl", "label": "Extra large" },
        { "value": "fs-2xl", "label": "2X large" }
      ],
      "default": "fs-sm"
    },
    {
      "type": "select",
      "id": "font_size_desktop",
      "label": "Font size desktop",
      "options": [
        { "value": "fs-xs", "label": "Extra small" },
        { "value": "fs-sm", "label": "Small" },
        { "value": "fs-md", "label": "Medium" },
        { "value": "fs-lg", "label": "Large" },
        { "value": "fs-xl", "label": "Extra large" },
        { "value": "fs-2xl", "label": "2X large" }
      ],
      "default": "fs-md"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "{{ settings.colors.brand }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "{{ settings.colors.background }}"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 10
    }
  ],
  "blocks": [],
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "Announcement bar",
      "category": "Header"
    }
  ]
}
{% endschema %}
