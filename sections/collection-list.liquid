{% liquid
  assign layout = section.settings.layout | default: 'grid'
  assign placeholder_count = 6

  capture header_content
    content_for 'blocks'
  endcapture
%}

{% if section.index <= 3 or request.design_mode %}
  <link href="{{ 'collection-list.css' | asset_url }}" rel="stylesheet" fetchpriority="high">
  <link href="{{ 'collection-card.css' | asset_url }}" rel="stylesheet" fetchpriority="high">
{% endif %}

<div
  class="collection-list section-spacing"
  style="
    --color-background: {{ section.settings.background_color.red }} {{ section.settings.background_color.green }} {{ section.settings.background_color.blue }};
    --color-text: {{ section.settings.text_color.red }} {{ section.settings.text_color.green }} {{ section.settings.text_color.blue }};
    --color-accent: {{ section.settings.accent_color.red }} {{ section.settings.accent_color.green }} {{ section.settings.accent_color.blue }};
    --pt: {{ section.settings.pt | divided_by: 16.0 | append: 'em' }};
    --pb: {{ section.settings.pb | divided_by: 16.0 | append: 'em' }};
  "
  data-section-css="{{ 'collection-list.css' | asset_url }}, {{ 'collection-card.css' | asset_url }}"
>
  <div class="container {{ settings.container_width }}">
    {% if header_content != blank %}
      <div
        class="collection-list-header responsive-text-alignment"
        data-mobile-text-alignment="{{ section.settings.header_mobile_text_alignment }}"
        data-desktop-text-alignment="{{ section.settings.header_desktop_text_alignment }}"
        style="
          --mobile-text-alignment: {{ section.settings.header_mobile_text_alignment }};
          --desktop-text-alignment: {{ section.settings.header_desktop_text_alignment }};
        "
      >
        {{ header_content }}
      </div>
    {% endif %}

    {% if layout == 'carousel' %}
      <theme-carousel
        class="theme-carousel"
        data-partial-slide-mobile="{{ section.settings.carousel_partial_slide_mobile }}"
        role="region"
        aria-roledescription="{{ 'accessibility.carousel' | t }}"
        aria-label="{{ 'accessibility.collections_carousel' | t }}"
        style="
          --carousel-columns-mobile: {{ section.settings.mobile_columns }};
          --carousel-columns-tablet: 2;
          --carousel-columns-desktop: {{ section.settings.desktop_columns }};
          --carousel-gap: 1rem;
        "
      >
        <div class="theme-carousel-track-wrapper">
          <ul
            id="collection-list-track-{{ section.id }}"
            class="theme-carousel-track"
            role="list"
            tabindex="0"
            data-carousel-track
          >
            {% for collection in section.settings.collections %}
              <li class="collection-list-item theme-carousel-item" data-carousel-item>
                {% content_for 'block', type: 'collection-card', id: 'collection-card', closest.collection: collection %}
              </li>
            {% else %}
              {% for index in (1..placeholder_count) %}
                <li class="collection-list-item theme-carousel-item" data-carousel-item>
                  {% content_for 'block', type: 'collection-card', id: 'collection-card', closest.collection: null %}
                </li>
              {% endfor %}
            {% endfor %}
          </ul>

          {% if section.settings.carousel_show_navigation %}
            <div class="theme-carousel-controls">
              <button
                class="icon-button theme-carousel-control theme-carousel-control-previous"
                type="button"
                aria-label="{{ 'accessibility.previous' | t }}"
                aria-controls="collection-list-track-{{ section.id }}"
                data-carousel-previous
              >
                {% render 'svg-icons', icon: 'chevron-left', icon_size: 20 %}
              </button>
              <button
                class="icon-button theme-carousel-control theme-carousel-control-next"
                type="button"
                aria-label="{{ 'accessibility.next' | t }}"
                aria-controls="collection-list-track-{{ section.id }}"
                data-carousel-next
              >
                {% render 'svg-icons', icon: 'chevron-right', icon_size: 20 %}
              </button>
            </div>
          {% endif %}
        </div>

        {% if section.settings.carousel_show_progress %}
          <div class="theme-carousel-progress" aria-hidden="true">
            <div class="theme-carousel-progress-bar" data-carousel-progress-bar></div>
          </div>
        {% endif %}
      </theme-carousel>
    {% else %}
      <ul
        class="collection-list-grid"
        role="list"
        style="
          --mobile-columns: {{ section.settings.mobile_columns }};
          --desktop-columns: {{ section.settings.desktop_columns }};
        "
      >
        {% for collection in section.settings.collections %}
          <li class="collection-list-item">
            {% content_for 'block', type: 'collection-card', id: 'collection-card', closest.collection: collection %}
          </li>
        {% else %}
          {% for index in (1..placeholder_count) %}
            <li class="collection-list-item">
              {% content_for 'block', type: 'collection-card', id: 'collection-card', closest.collection: null %}
            </li>
          {% endfor %}
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Collection list",
  "tag": "section",
  "settings": [
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "limit": 24
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "{{ settings.colors.background }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "{{ settings.colors.text }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "{{ settings.colors.accent }}"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text_alignment",
      "id": "header_mobile_text_alignment",
      "label": "Mobile text alignment",
      "default": "left"
    },
    {
      "type": "text_alignment",
      "id": "header_desktop_text_alignment",
      "label": "Desktop text alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "carousel", "label": "Carousel" },
        { "value": "grid", "label": "Grid" }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "carousel_partial_slide_mobile",
      "label": "Show part of the next collection on mobile",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_show_navigation",
      "label": "Show navigation buttons",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_show_progress",
      "label": "Show progress bar",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'carousel' }}"
    },
    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "info": "Tablet layouts always use two columns.",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "Collection list",
      "category": "Collections",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "heading": "Shop by collection",
            "heading_tag": "2",
            "heading_size": "h2",
            "pt": 0,
            "pb": 6
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>Explore collections created to help customers find the products that suit them best.</p>",
            "text_size": "fs-md",
            "pt": 0,
            "pb": 0
          }
        },
        {
          "type": "collection-card",
          "id": "collection-card",
          "static": true,
          "settings": {
            "text_alignment": "left"
          },
          "blocks": [
            {
              "type": "_collection-card-image",
              "settings": {
                "image_ratio": "square"
              }
            },
            {
              "type": "_collection-card-title",
              "settings": {
                "font_family": "heading",
                "heading_size": "fs-md"
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
