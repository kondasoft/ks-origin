<div
  class="contact-form-section section-spacing"
  data-input-background="{% if section.settings.background_color == settings.color_surface %}site{% else %}section{% endif %}"
  style="
    --color-background: {{ section.settings.background_color.red }} {{ section.settings.background_color.green }} {{ section.settings.background_color.blue }};
    --color-text: {{ section.settings.text_color.red }} {{ section.settings.text_color.green }} {{ section.settings.text_color.blue }};
    --color-accent: {{ section.settings.accent_color.red }} {{ section.settings.accent_color.green }} {{ section.settings.accent_color.blue }};
    --pt: {{ section.settings.pt | divided_by: 16.0 | append: 'em' }};
    --pb: {{ section.settings.pb | divided_by: 16.0 | append: 'em' }};
  "
>
  <div class="container container-content">
    {% content_for 'block', type: 'group', id: 'header' %}

    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "{{ settings.colors.surface }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "{{ settings.colors.text }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "{{ settings.colors.accent }}"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "contact-form"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "Contact form",
      "category": "Contact",
      "blocks": [
        {
          "type": "group",
          "id": "header",
          "static": true,
          "name": "Header",
          "settings": {
            "mobile_content_direction": "column",
            "mobile_gap": 0,
            "mobile_alignment": "inherit",
            "desktop_content_direction": "column",
            "desktop_gap": 0,
            "desktop_alignment": "inherit",
            "pt": 0,
            "pb": 28,
            "pl": 0,
            "pr": 0
          },
          "blocks": [
            {
              "type": "heading",
              "settings": {
                "heading": "Contact us",
                "heading_tag": "2",
                "heading_size": "h2",
                "pt": 0,
                "pb": 0
              }
            },
            {
              "type": "text",
              "settings": {
                "text": "<p>Have a question or need help? Send us a message and we'll get back to you as soon as possible.</p>",
                "text_size": "fs-md",
                "pt": 6,
                "pb": 0
              }
            }
          ]
        },
        {
          "type": "contact-form",
          "settings": {
            "pt": 0
          }
        }
      ]
    }
  ]
}
{% endschema %}
