{% if predictive_search.performed %}
  {% liquid
    assign result_count = predictive_search.resources.queries.size
    assign result_count = result_count | plus: predictive_search.resources.products.size
    assign result_count = result_count | plus: predictive_search.resources.collections.size
    assign result_count = result_count | plus: predictive_search.resources.articles.size
    assign result_count = result_count | plus: predictive_search.resources.pages.size
    assign encoded_terms = predictive_search.terms | url_encode
    assign escaped_terms = predictive_search.terms | escape
    assign search_url = routes.search_url | append: '?q=' | append: encoded_terms | append: '&type=product%2Carticle%2Cpage&options%5Bprefix%5D=last'
  %}

  <div class="predictive-search-content">
    {% if result_count > 0 %}
      {% if predictive_search.resources.queries.size > 0 %}
        <div class="predictive-search-group">
          <h3 id="PredictiveSearchQueries" class="predictive-search-heading fs-sm">
            {{ 'search.groups.suggestions' | t }}
          </h3>
          <ul class="predictive-search-list" role="group" aria-labelledby="PredictiveSearchQueries">
            {% for query in predictive_search.resources.queries %}
              <li
                id="PredictiveSearchOptionQuery-{{ forloop.index }}"
                class="predictive-search-option"
                role="option"
                aria-selected="false"
                data-predictive-search-option
              >
                <a class="predictive-search-link" href="{{ query.url }}" tabindex="-1">
                  {{ query.styled_text }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      {% if predictive_search.resources.products.size > 0 %}
        <div class="predictive-search-group">
          <h3 id="PredictiveSearchProducts" class="predictive-search-heading fs-sm">
            {{ 'search.groups.products' | t }}
          </h3>
          <ul class="predictive-search-product-list" role="group" aria-labelledby="PredictiveSearchProducts">
            {% for product in predictive_search.resources.products %}
              {% assign product_price = product.price | money %}
              <li
                id="PredictiveSearchOptionProduct-{{ forloop.index }}"
                class="predictive-search-option predictive-search-product-option"
                role="option"
                aria-selected="false"
                data-predictive-search-option
              >
                <article class="predictive-search-product-card">
                  <div class="predictive-search-product-image-wrapper">
                    {% if product.featured_image != blank %}
                      {{ product.featured_image
                        | image_url: width: 160
                        | image_tag:
                          class: 'predictive-search-product-image',
                          widths: '64, 128, 160',
                          sizes: '64px',
                          loading: 'lazy'
                      }}
                    {% else %}
                      {{ 'product-apparel-1' | placeholder_svg_tag: 'predictive-search-product-image placeholder-svg' }}
                    {% endif %}
                  </div>
                  <div class="predictive-search-product-content">
                    <h4 class="predictive-search-product-title fs-md">
                      <a href="{{ product.url }}" tabindex="-1">
                        {{ product.title | escape }}
                      </a>
                    </h4>
                    <p class="predictive-search-product-price fs-sm">
                      {% if product.price_varies %}
                        {{ 'products.price.from_price' | t: price: product_price }}
                      {% else %}
                        {{ product.price | money }}
                      {% endif %}
                      {% if product.compare_at_price > product.price %}
                        <s>{{ product.compare_at_price | money }}</s>
                      {% endif %}
                    </p>
                  </div>
                </article>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      {% if predictive_search.resources.collections.size > 0 %}
        <div class="predictive-search-group">
          <h3 id="PredictiveSearchCollections" class="predictive-search-heading fs-sm">
            {{ 'search.groups.collections' | t }}
          </h3>
          <ul class="predictive-search-list" role="group" aria-labelledby="PredictiveSearchCollections">
            {% for collection in predictive_search.resources.collections %}
              <li
                id="PredictiveSearchOptionCollection-{{ forloop.index }}"
                class="predictive-search-option"
                role="option"
                aria-selected="false"
                data-predictive-search-option
              >
                <a class="predictive-search-link" href="{{ collection.url }}" tabindex="-1">
                  {{ collection.title | escape }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      {% if predictive_search.resources.articles.size > 0 %}
        <div class="predictive-search-group">
          <h3 id="PredictiveSearchArticles" class="predictive-search-heading fs-sm">
            {{ 'search.groups.articles' | t }}
          </h3>
          <ul class="predictive-search-list" role="group" aria-labelledby="PredictiveSearchArticles">
            {% for article in predictive_search.resources.articles %}
              <li
                id="PredictiveSearchOptionArticle-{{ forloop.index }}"
                class="predictive-search-option"
                role="option"
                aria-selected="false"
                data-predictive-search-option
              >
                <a class="predictive-search-link" href="{{ article.url }}" tabindex="-1">
                  {{ article.title | escape }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      {% if predictive_search.resources.pages.size > 0 %}
        <div class="predictive-search-group">
          <h3 id="PredictiveSearchPages" class="predictive-search-heading fs-sm">
            {{ 'search.groups.pages' | t }}
          </h3>
          <ul class="predictive-search-list" role="group" aria-labelledby="PredictiveSearchPages">
            {% for page in predictive_search.resources.pages %}
              <li
                id="PredictiveSearchOptionPage-{{ forloop.index }}"
                class="predictive-search-option"
                role="option"
                aria-selected="false"
                data-predictive-search-option
              >
                <a class="predictive-search-link" href="{{ page.url }}" tabindex="-1">
                  {{ page.title | escape }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      <a
        id="PredictiveSearchViewAll"
        class="btn btn-accent-outline predictive-search-view-all"
        href="{{ search_url | escape }}"
      >
        {{ 'search.view_all' | t: terms: escaped_terms }}
      </a>
    {% else %}
      <p class="predictive-search-empty">
        {{ 'search.no_results' | t: terms: escaped_terms }}
      </p>
    {% endif %}

    <span data-predictive-search-count hidden>
      {{ 'search.results_count' | t: count: result_count }}
    </span>
  </div>
{% endif %}

{% schema %}
{
  "name": "Predictive search",
  "settings": []
}
{% endschema %}
