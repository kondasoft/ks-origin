{% liquid
  assign container_class = 'password-section-content'
  assign message_blocks = section.blocks | where: 'type', '_password-message'

  if section.settings.container_width == 'site'
    assign container_class = container_class | append: ' container'
  elsif section.settings.container_width == 'narrow'
    assign container_class = container_class | append: ' container container-content'
  endif
%}

<div
  class="password-section section-spacing"
  style="
    --color-background: {{ section.settings.background_color.red }} {{ section.settings.background_color.green }} {{ section.settings.background_color.blue }};
    --color-text: {{ section.settings.text_color.red }} {{ section.settings.text_color.green }} {{ section.settings.text_color.blue }};
    --color-accent: {{ section.settings.accent_color.red }} {{ section.settings.accent_color.green }} {{ section.settings.accent_color.blue }};
    --mobile-text-alignment: {{ section.settings.mobile_text_alignment }};
    --desktop-text-alignment: {{ section.settings.desktop_text_alignment }};
    --pt: {{ section.settings.pt | divided_by: 16.0 | append: 'em' }};
    --pb: {{ section.settings.pb | divided_by: 16.0 | append: 'em' }};
  "
>
  <div class="{{ container_class }}">
    {% content_for 'blocks' %}
    {% comment %}Existing templates get the message until a merchant adds a block to control its placement.{% endcomment %}
    {% if message_blocks.size == 0 and section.settings.show_password_message %}
      {% render 'password-message', text_size: 'fs-md', pt: 24, pb: 0 %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_password_message",
      "label": "Show visitor message when no message block is added",
      "info": "Add a Visitor message block to control its position, text size and spacing.",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "{{ settings.colors.background }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "{{ settings.colors.text }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "{{ settings.colors.accent }}"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "site", "label": "Site container" },
        { "value": "narrow", "label": "Narrow container" }
      ],
      "default": "narrow"
    },
    {
      "type": "text_alignment",
      "id": "mobile_text_alignment",
      "label": "Mobile text alignment",
      "default": "center"
    },
    {
      "type": "text_alignment",
      "id": "desktop_text_alignment",
      "label": "Desktop text alignment",
      "default": "center"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "_password-message"
    },
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "enabled_on": {
    "templates": ["password"]
  }
}
{% endschema %}
