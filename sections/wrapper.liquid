<div
  class="wrapper section-spacing"
  style="
    --pt: {{ section.settings.pt | divided_by: 16.0 | append: 'em' }};
    --pb: {{ section.settings.pb | divided_by: 16.0 | append: 'em' }};
  "
>
  <div class="container {{ settings.container_width }}">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "Wrapper",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "Wrapper",
      "category": "Layout"
    }
  ]
}
{% endschema %}
