<div
  class="main-cart section-spacing"
  style="
    --color-background: {{ section.settings.background_color.red }} {{ section.settings.background_color.green }} {{ section.settings.background_color.blue }};
    --color-text: {{ section.settings.text_color.red }} {{ section.settings.text_color.green }} {{ section.settings.text_color.blue }};
    --color-accent: {{ section.settings.accent_color.red }} {{ section.settings.accent_color.green }} {{ section.settings.accent_color.blue }};
    --pt: {{ section.settings.pt | divided_by: 16.0 | append: 'em' }};
    --pb: {{ section.settings.pb | divided_by: 16.0 | append: 'em' }};
    color: rgb(var(--color-text));
    background-color: rgb(var(--color-background));
  "
>
  <div class="container {{ settings.container_width }}">
    <h1
      class="main-cart-heading responsive-text-alignment {{ section.settings.heading_size }}"
      style="
        --mobile-text-alignment: {{ section.settings.mobile_text_alignment }};
        --desktop-text-alignment: {{ section.settings.desktop_text_alignment }};
      "
    >
      {{ 'accessibility.cart' | t }}
    </h1>

    <div class="main-cart-layout">
      <div class="main-cart-content">
        {% render 'cart-items', context: 'page' %}
        <div
          class="cart-options"
          data-cart-options
          data-context="page"
          {% if cart.empty? %}
            hidden
          {% endif %}
        >
          {% render 'cart-note', context: 'page' %}
          {% render 'cart-discount', context: 'page' %}
        </div>
      </div>
      <div
        id="cart-page-summary"
        class="main-cart-summary"
        data-cart-summary
        data-context="page"
        {% if cart.empty? %}
          hidden
        {% endif %}
      >
        {% render 'cart-summary' %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "{{ settings.colors.background }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "{{ settings.colors.text }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "{{ settings.colors.accent }}"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text_alignment",
      "id": "mobile_text_alignment",
      "label": "Mobile text alignment",
      "default": "left"
    },
    {
      "type": "text_alignment",
      "id": "desktop_text_alignment",
      "label": "Desktop text alignment",
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h1",
      "info": "Changes the visual size only. The HTML heading remains H1."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 60
    }
  ],
  "enabled_on": {
    "templates": ["cart"]
  },
  "presets": [
    {
      "name": "Cart",
      "category": "Cart"
    }
  ]
}
{% endschema %}
