{% liquid
  assign load_footer_css = true
  assign show_country_selector = false
  assign show_follow_on_shop = false
  assign show_language_selector = false
  assign show_payment_icons = false

  if request.page_type == 'index' or request.page_type == 'collection' or request.page_type == 'product'
    assign load_footer_css = false
  endif

  if section.settings.enable_follow_on_shop and shop.features.follow_on_shop?
    assign show_follow_on_shop = true
  endif

  if section.settings.show_country_selector and localization.available_countries.size > 1
    assign show_country_selector = true
  endif

  if section.settings.show_language_selector and localization.available_languages.size > 1
    assign show_language_selector = true
  endif

  if section.settings.show_payment_icons and shop.enabled_payment_types != empty
    assign show_payment_icons = true
  endif

  assign shop_name = shop.name | escape | split: '(' | first | strip
%}

{% if load_footer_css %}
  <link href="{{ 'footer.css' | asset_url }}" rel="stylesheet" fetchpriority="high">
{% endif %}

<div
  class="footer"
  style="
    --color-background: {{ section.settings.background_color.red }} {{ section.settings.background_color.green }} {{ section.settings.background_color.blue }};
    --color-text: {{ section.settings.text_color.red }} {{ section.settings.text_color.green }} {{ section.settings.text_color.blue }};
    --color-accent: {{ section.settings.accent_color.red }} {{ section.settings.accent_color.green }} {{ section.settings.accent_color.blue }};
    --pt: {{ section.settings.pt | divided_by: 16.0 | append: 'em' }};
    --pb: {{ section.settings.pb | divided_by: 16.0 | append: 'em' }};
  "
  data-section-css="{{ 'footer.css' | asset_url }}"
>
  <div class="container {{ settings.container_width }}">
    {% if section.blocks.size > 0 %}
      <div class="footer-blocks">
        {% for block in section.blocks %}
          <div
            class="footer-block footer-block-{{ block.type }}"
            {{ block.shopify_attributes }}
          >
            <theme-collapse
              class="theme-collapse footer-block-collapse"
              data-collapse-mobile
            >
              <details class="theme-collapse-details footer-block-details" open>
                <summary class="theme-collapse-summary footer-block-summary">
                  <span class="footer-block-title">{{ block.settings.heading }}</span>
                  <span class="theme-collapse-icon footer-block-icon" aria-hidden="true">
                    {% render 'svg-icons', icon: 'chevron-down', icon_size: 18 %}
                  </span>
                </summary>

                <div class="theme-collapse-content footer-block-content">
                  {% if block.settings.heading != blank %}
                    <h2 class="footer-block-heading {{ block.settings.heading_size }}">{{ block.settings.heading }}</h2>
                  {% endif %}

                  {% case block.type %}
                    {% when 'menu' %}
                      <ul class="footer-menu-list" role="list">
                        {% for index in (1..10) %}
                          {% liquid
                            assign label_key = 'link_' | append: index | append: '_label'
                            assign url_key = 'link_' | append: index | append: '_url'
                            assign link_label = block.settings[label_key]
                            assign link_url = block.settings[url_key] | default: routes.root_url
                          %}

                          {% if link_label != blank %}
                            <li>
                              <a href="{{ link_url }}">{{ link_label | escape }}</a>
                            </li>
                          {% endif %}
                        {% endfor %}
                      </ul>

                    {% when 'text' %}
                      {% if block.settings.text != blank %}
                        <div class="footer-text rte {{ block.settings.text_size }}">
                          {{ block.settings.text }}
                        </div>
                      {% endif %}

                      {% if block.settings.button_1_label != blank or block.settings.button_2_label != blank %}
                        <div class="footer-text-buttons">
                          {% for index in (1..2) %}
                            {% liquid
                              assign label_key = 'button_' | append: index | append: '_label'
                              assign link_key = 'button_' | append: index | append: '_link'
                              assign style_key = 'button_' | append: index | append: '_style'
                              assign size_key = 'button_' | append: index | append: '_size'
                              assign button_label = block.settings[label_key]
                              assign button_link = block.settings[link_key] | default: routes.root_url
                              assign button_style = block.settings[style_key]
                              assign button_size = block.settings[size_key]
                            %}

                            {% if button_label != blank %}
                              <a class="btn btn-wide {{ button_size }} {{ button_style }}" href="{{ button_link }}">
                                {{ button_label | escape }}
                              </a>
                            {% endif %}
                          {% endfor %}
                        </div>
                      {% endif %}

                    {% when 'newsletter' %}
                      {% assign form_id = 'FooterNewsletterForm-' | append: section.id | append: '-' | append: block.id %}

                      {% if block.settings.text != blank %}
                        <div class="footer-newsletter-text rte {{ block.settings.text_size }}">
                          {{ block.settings.text }}
                        </div>
                      {% endif %}

                      {% form 'customer', id: form_id, class: 'footer-newsletter-form' %}
                        <input type="hidden" name="contact[tags]" value="newsletter">

                        {% if form.errors %}
                          <div
                            id="{{ form_id }}-error"
                            class="footer-newsletter-form-status alert alert-with-icon alert-error"
                            role="alert"
                            tabindex="-1"
                            autofocus
                          >
                            {{ form.errors | default_errors }}
                          </div>
                        {% endif %}

                        {% if form.posted_successfully? %}
                          <div
                            class="footer-newsletter-form-status alert alert-with-icon alert-success"
                            role="status"
                            tabindex="-1"
                            autofocus
                          >
                            {{ 'general.email_signup.form.success' | t }}
                          </div>
                        {% endif %}

                        <div class="footer-newsletter-form-fields input-wrapper">
                          <label class="visually-hidden" for="{{ form_id }}-email">
                            {{ 'general.email_signup.form.email' | t }}
                          </label>
                          <input
                            id="{{ form_id }}-email"
                            class="footer-newsletter-form-input input input-with-icon-right input-{{ block.settings.input_size }}"
                            type="email"
                            name="contact[email]"
                            value="{% if customer %}{{ customer.email }}{% endif %}"
                            autocomplete="email"
                            autocapitalize="off"
                            spellcheck="false"
                            placeholder="{{ 'general.email_signup.form.placeholder' | t }}"
                            aria-required="true"
                            required
                            {% if form.errors contains 'email' %}
                              aria-invalid="true"
                              aria-describedby="{{ form_id }}-error"
                            {% endif %}
                          >
                          <button
                            class="footer-newsletter-form-button icon-button input-icon-right"
                            type="submit"
                            aria-label="{{ 'general.email_signup.form.submit' | t }}"
                          >
                            {% render 'svg-icons', icon: 'send', icon_size: 18 %}
                          </button>
                        </div>
                      {% endform %}

                      {% if block.settings.show_social_links %}
                        {% render 'social-icons',
                          icon_size: block.settings.social_icon_size,
                          wrapper_class: 'footer-newsletter-social'
                        %}
                      {% endif %}
                  {% endcase %}
                </div>
              </details>
            </theme-collapse>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    <div class="footer-bottom">
      <p class="footer-copyright">
        &copy; {{ 'now' | date: '%Y' }}
        <a href="{{ routes.root_url }}">{{ shop_name }}</a>.
        {{ 'general.footer.all_rights_reserved' | t }}
      </p>

      {% if section.settings.show_policy_links and shop.policies.size > 0 %}
        <ul class="footer-policy-list" role="list">
          {% for policy in shop.policies %}
            <li>
              <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}

      {% if show_country_selector or show_language_selector %}
        <div class="footer-localization">
          {% if show_language_selector %}
            <button
              class="footer-localization-button"
              type="button"
              data-toggle="languages-dialog"
              aria-controls="languages-dialog"
              aria-haspopup="dialog"
              aria-label="{{ 'general.localization.language' | t }}: {{ localization.language.endonym_name | capitalize | escape }}"
            >
              {% render 'svg-icons', icon: 'translate', icon_size: 18 %}
              <span>
                {{ localization.language.endonym_name | capitalize }}
                <small>({{ localization.language.iso_code }})</small>
              </span>
            </button>
          {% endif %}

          {% if show_country_selector %}
            <button
              class="footer-localization-button"
              type="button"
              data-toggle="countries-dialog"
              aria-controls="countries-dialog"
              aria-haspopup="dialog"
              aria-label="{{ 'general.localization.country' | t }}: {{ localization.country.name | escape }}"
            >
              <span class="footer-localization-image" aria-hidden="true">
                {{ localization.country | image_url: width: 18, height: 18 | image_tag: loading: 'lazy' }}
              </span>
              <span>
                {{ localization.country.name }}
                <small>
                  ({{ localization.country.currency.iso_code }}
                  {{ localization.country.currency.symbol }})
                </small>
              </span>
            </button>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.show_social_links %}
        {% render 'social-icons',
          icon_size: section.settings.social_icon_size,
          wrapper_class: 'footer-social'
        %}
      {% endif %}

      {% if show_payment_icons %}
        {% render 'payment-icons', icon_size: 18, wrapper_class: 'footer-payment-icons' %}
      {% endif %}

      {% if show_follow_on_shop %}
        <div class="footer-follow-on-shop">
          {{ shop | login_button: action: 'follow' }}
        </div>
      {% endif %}

      {% if section.settings.show_theme_credits or section.settings.show_powered_by_shopify %}
        <p class="footer-credits">
          {% if section.settings.show_theme_credits %}
            <span>
              {{ 'general.footer.designed_with' | t }}
              <span class="footer-heart" aria-hidden="true">&hearts;</span><span class="visually-hidden">{{ 'accessibility.love' | t }}</span>
              {{ 'general.footer.by' | t }}
              <a href="https://kondasoft.com" target="_blank" rel="nofollow noopener">KondaSoft</a>
            </span>
          {% endif %}

          {% if section.settings.show_powered_by_shopify %}
            <span class="footer-powered-by">
              {% if section.settings.show_theme_credits %}
                <span class="footer-credit-separator" aria-hidden="true">&middot;&nbsp;</span>
              {% endif %}
              {{ powered_by_link }}
            </span>
          {% endif %}
        </p>
      {% endif %}
    </div>
  </div>
</div>

