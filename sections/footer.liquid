{% liquid
  assign show_follow_on_shop = false
  assign show_footer_bottom = false

  if section.settings.enable_follow_on_shop and shop.features.follow_on_shop?
    assign show_follow_on_shop = true
  endif

  if section.settings.show_copyright or section.settings.show_theme_credits or section.settings.show_powered_by_shopify
    assign show_footer_bottom = true
  elsif show_follow_on_shop
    assign show_footer_bottom = true
  elsif section.settings.show_policy_links and shop.policies.size > 0
    assign show_footer_bottom = true
  endif

  assign shop_name = shop.name | escape | split: '(' | first | strip
%}

<div
  class="footer"
  style="
    --color-background: {{ section.settings.background_color.red }} {{ section.settings.background_color.green }} {{ section.settings.background_color.blue }};
    --color-text: {{ section.settings.text_color.red }} {{ section.settings.text_color.green }} {{ section.settings.text_color.blue }};
    --color-accent: {{ section.settings.accent_color.red }} {{ section.settings.accent_color.green }} {{ section.settings.accent_color.blue }};
    --pt: {{ section.settings.pt | divided_by: 16.0 | append: 'em' }};
    --pb: {{ section.settings.pb | divided_by: 16.0 | append: 'em' }};
  "
  data-section-css="{{ 'footer.css' | asset_url }}"
>
  <div class="container {{ settings.container_width }}">
    {% if section.blocks.size > 0 %}
      <div class="footer-blocks">
        {% for block in section.blocks %}
          <div
            class="footer-block footer-block-{{ block.type }}"
            {{ block.shopify_attributes }}
          >
            <theme-collapse
              class="theme-collapse footer-block-collapse"
              data-collapse-mobile
            >
              <details class="theme-collapse-details footer-block-details" open>
                <summary class="theme-collapse-summary footer-block-summary">
                  <span class="footer-block-title">{{ block.settings.heading }}</span>
                  <span class="theme-collapse-icon footer-block-icon" aria-hidden="true">
                    {% render 'svg-icons', icon: 'chevron-down', icon_size: 18 %}
                  </span>
                </summary>

                <div class="theme-collapse-content footer-block-content">
                  {% if block.settings.heading != blank %}
                    <h2 class="footer-block-heading">{{ block.settings.heading }}</h2>
                  {% endif %}

                  {% case block.type %}
                    {% when 'menu' %}
                      <ul class="footer-menu-list" role="list">
                        {% for index in (1..10) %}
                          {% liquid
                            assign label_key = 'link_' | append: index | append: '_label'
                            assign url_key = 'link_' | append: index | append: '_url'
                            assign link_label = block.settings[label_key]
                            assign link_url = block.settings[url_key] | default: routes.root_url
                          %}

                          {% if link_label != blank %}
                            <li>
                              <a href="{{ link_url }}">{{ link_label | escape }}</a>
                            </li>
                          {% endif %}
                        {% endfor %}
                      </ul>

                    {% when 'text' %}
                      {% if block.settings.text != blank %}
                        <div class="footer-text rte">
                          {{ block.settings.text }}
                        </div>
                      {% endif %}
                  {% endcase %}
                </div>
              </details>
            </theme-collapse>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if show_footer_bottom %}
      <div class="footer-bottom">
        {% if section.settings.show_copyright or section.settings.show_theme_credits or section.settings.show_powered_by_shopify %}
          <div class="footer-information">
            {% if section.settings.show_copyright %}
              <p class="footer-copyright">
                &copy; {{ 'now' | date: '%Y' }}
                <a href="{{ routes.root_url }}">{{ shop_name }}</a>.
                {{ 'footer.all_rights_reserved' | t }}
              </p>
            {% endif %}

            {% if section.settings.show_policy_links and shop.policies.size > 0 %}
              <ul class="footer-policy-list" role="list">
                {% for policy in shop.policies %}
                  <li>
                    <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}

            {% if section.settings.show_theme_credits or section.settings.show_powered_by_shopify %}
              <p class="footer-credits">
                {% if section.settings.show_theme_credits %}
                  <span>
                    {{ 'footer.designed_with' | t }}
                    <span class="footer-heart" aria-hidden="true">&hearts;</span><span class="visually-hidden">{{ 'accessibility.love' | t }}</span>
                    {{ 'footer.by' | t }}
                    <a href="https://kondasoft.com" target="_blank" rel="nofollow noopener">KondaSoft</a>
                  </span>
                {% endif %}

                {% if section.settings.show_powered_by_shopify %}
                  <span class="footer-powered-by">
                    {% if section.settings.show_theme_credits %}
                      <span class="footer-credit-separator" aria-hidden="true">&middot;&nbsp;</span>
                    {% endif %}
                    {{ powered_by_link }}
                  </span>
                {% endif %}
              </p>
            {% endif %}
          </div>
        {% endif %}

        {% if show_follow_on_shop %}
          <div class="footer-follow-on-shop">
            {{ shop | login_button: action: 'follow' }}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

