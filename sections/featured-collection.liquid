{% liquid
  assign products_to_show = section.settings.products_to_show | default: 4
  assign layout = section.settings.layout | default: 'carousel'
  assign carousel_label = section.settings.collection.title

  if carousel_label == blank
    assign carousel_label = 'accessibility.products_carousel' | t
  endif

  capture header_content
    content_for 'blocks'
  endcapture
%}

{% if section.index <= 3 or request.design_mode %}
  <link href="{{ 'featured-collection.css' | asset_url }}" rel="stylesheet" fetchpriority="high">
  <link href="{{ 'product-card.css' | asset_url }}" rel="stylesheet" fetchpriority="high">
{% endif %}

<div
  class="featured-collection section-spacing"
  style="
    --color-background: {{ section.settings.background_color.red }} {{ section.settings.background_color.green }} {{ section.settings.background_color.blue }};
    --color-text: {{ section.settings.text_color.red }} {{ section.settings.text_color.green }} {{ section.settings.text_color.blue }};
    --color-accent: {{ section.settings.accent_color.red }} {{ section.settings.accent_color.green }} {{ section.settings.accent_color.blue }};
    --pt: {{ section.settings.pt | divided_by: 16.0 | append: 'em' }};
    --pb: {{ section.settings.pb | divided_by: 16.0 | append: 'em' }};
  "
  data-section-css="{{ 'featured-collection.css' | asset_url }}, {{ 'product-card.css' | asset_url }}"
>
  <div class="container {{ settings.container_width }}">
    {% if header_content != blank %}
      <div
        class="featured-collection-header responsive-text-alignment"
        data-mobile-text-alignment="{{ section.settings.header_mobile_text_alignment }}"
        data-desktop-text-alignment="{{ section.settings.header_desktop_text_alignment }}"
        style="
          --mobile-text-alignment: {{ section.settings.header_mobile_text_alignment }};
          --desktop-text-alignment: {{ section.settings.header_desktop_text_alignment }};
        "
      >
        {{ header_content }}
      </div>
    {% endif %}

    {% if layout == 'carousel' %}
      <theme-carousel
        class="theme-carousel"
        data-align-navigation-to-media="{{ section.settings.carousel_align_navigation_to_media }}"
        data-partial-slide-mobile="{{ section.settings.carousel_partial_slide_mobile }}"
        role="region"
        aria-roledescription="{{ 'accessibility.carousel' | t }}"
        aria-label="{{ carousel_label | escape }}"
        style="
          --carousel-columns-mobile: {{ section.settings.mobile_columns }};
          --carousel-columns-tablet: 2;
          --carousel-columns-desktop: {{ section.settings.desktop_columns }};
          --carousel-gap: 1rem;
        "
      >
        <div class="theme-carousel-track-wrapper">
          <ul
            id="featured-collection-track-{{ section.id }}"
            class="theme-carousel-track"
            role="list"
            tabindex="0"
            data-carousel-track
          >
            {% for product in section.settings.collection.products limit: products_to_show %}
              <li class="featured-collection-item theme-carousel-item" data-carousel-item>
                {% content_for 'block', type: 'product-card', id: 'product-card', closest.product: product %}
              </li>
            {% else %}
              {% for index in (1..products_to_show) %}
                <li class="featured-collection-item theme-carousel-item" data-carousel-item>
                  {% content_for 'block', type: 'product-card', id: 'product-card', closest.product: null %}
                </li>
              {% endfor %}
            {% endfor %}
          </ul>

          {% if section.settings.carousel_show_navigation %}
            <div class="theme-carousel-controls">
              <button
                class="icon-button theme-carousel-control theme-carousel-control-previous"
                type="button"
                aria-label="{{ 'accessibility.previous' | t }}"
                aria-controls="featured-collection-track-{{ section.id }}"
                data-carousel-previous
              >
                {% render 'svg-icons', icon: 'chevron-left', icon_size: 20 %}
              </button>
              <button
                class="icon-button theme-carousel-control theme-carousel-control-next"
                type="button"
                aria-label="{{ 'accessibility.next' | t }}"
                aria-controls="featured-collection-track-{{ section.id }}"
                data-carousel-next
              >
                {% render 'svg-icons', icon: 'chevron-right', icon_size: 20 %}
              </button>
            </div>
          {% endif %}
        </div>

        {% if section.settings.carousel_show_progress %}
          <div class="theme-carousel-progress" aria-hidden="true">
            <div class="theme-carousel-progress-bar" data-carousel-progress-bar></div>
          </div>
        {% endif %}
      </theme-carousel>
    {% else %}
      <ul
        class="featured-collection-grid"
        role="list"
        style="
          --mobile-columns: {{ section.settings.mobile_columns }};
          --desktop-columns: {{ section.settings.desktop_columns }};
        "
      >
        {% for product in section.settings.collection.products limit: products_to_show %}
          <li class="featured-collection-item">
            {% content_for 'block', type: 'product-card', id: 'product-card', closest.product: product %}
          </li>
        {% else %}
          {% for index in (1..products_to_show) %}
            <li class="featured-collection-item">
              {% content_for 'block', type: 'product-card', id: 'product-card', closest.product: null %}
            </li>
          {% endfor %}
        {% endfor %}
      </ul>
    {% endif %}

    {% if section.settings.show_view_all
      and section.settings.collection != blank
      and section.settings.view_all_label != blank
    %}
      <div class="featured-collection-view-all">
        <a
          class="btn btn-wide {{ section.settings.view_all_size }} {{ section.settings.view_all_style }}"
          href="{{ section.settings.collection.url }}"
        >
          {{ section.settings.view_all_label }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "{{ settings.colors.background }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "{{ settings.colors.text }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "{{ settings.colors.accent }}"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text_alignment",
      "id": "header_mobile_text_alignment",
      "label": "Mobile text alignment",
      "default": "left"
    },
    {
      "type": "text_alignment",
      "id": "header_desktop_text_alignment",
      "label": "Desktop text alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "carousel", "label": "Carousel" },
        { "value": "grid", "label": "Grid" }
      ],
      "default": "carousel"
    },
    {
      "type": "checkbox",
      "id": "carousel_partial_slide_mobile",
      "label": "Show part of the next product on mobile",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_show_navigation",
      "label": "Show navigation buttons",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_align_navigation_to_media",
      "label": "Align navigation to media",
      "info": "Centers navigation buttons against the card image. Disable to center them against the full card.",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'carousel' and section.settings.carousel_show_navigation }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_show_progress",
      "label": "Show progress bar",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'carousel' }}"
    },
    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "info": "Tablet layouts always use two columns.",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "View all button"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Button label",
      "default": "View all",
      "visible_if": "{{ section.settings.show_view_all }}"
    },
    {
      "type": "select",
      "id": "view_all_style",
      "label": "Button style",
      "options": [
        { "value": "btn-accent-solid", "label": "Accent solid" },
        { "value": "btn-accent-outline", "label": "Accent outline" },
        { "value": "btn-text-solid", "label": "Text solid" },
        { "value": "btn-text-outline", "label": "Text outline" }
      ],
      "default": "btn-text-outline",
      "visible_if": "{{ section.settings.show_view_all }}"
    },
    {
      "type": "select",
      "id": "view_all_size",
      "label": "Button size",
      "options": [
        { "value": "btn-sm", "label": "Small" },
        { "value": "btn-md", "label": "Medium" },
        { "value": "btn-lg", "label": "Large" }
      ],
      "default": "btn-md",
      "visible_if": "{{ section.settings.show_view_all }}"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "Featured collection",
      "category": "Products",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "heading": "Featured collection",
            "heading_tag": "2",
            "heading_size": "h2",
            "pt": 0,
            "pb": 6
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>Explore featured new arrivals, customer favorites, and everyday essentials.</p>",
            "text_size": "fs-md",
            "pt": 0,
            "pb": 0
          }
        },
        {
          "type": "product-card",
          "id": "product-card",
          "static": true,
          "settings": {
            "text_alignment": "left"
          },
          "blocks": [
            {
              "type": "_product-card-image",
              "settings": {
                "image_ratio": "square"
              }
            },
            {
              "type": "_product-card-title",
              "settings": {
                "font_family": "heading",
                "heading_size": "fs-md"
              }
            },
            {
              "type": "_product-card-rating",
              "settings": {
                "show_count": true,
                "rating_size": "fs-sm"
              }
            },
            {
              "type": "_product-card-price",
              "settings": {
                "price_size": "fs-md"
              }
            },
            {
              "type": "_product-card-form",
              "settings": {
                "button_style": "btn-accent-solid",
                "button_size": "btn-sm"
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
